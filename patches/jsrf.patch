+ * Each mapping is kept here, so VirtualFree can give it back and a commit on
+ * memory that is already mapped only changes its protection. */
+int32_t sceKernelAllocateDirectMemory(int64_t search_start, int64_t search_end, size_t length, size_t alignment,
+                                      int memory_type, int64_t *physical_start);
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int protection, int flags, int64_t physical_start,
+                                 size_t alignment);
+int32_t sceKernelReleaseDirectMemory(int64_t physical_start, size_t length);
