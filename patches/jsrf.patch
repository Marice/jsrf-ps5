+/* ---- command buffers and submission ---------------------------------------------------------------------------- */
+
+static void cmd_begin(VkCommandBuffer c)
+{
+	VkCommandBufferBeginInfo bi = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+	                               .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+	vkResetCommandBuffer(c, 0);
+	vkBeginCommandBuffer(c, &bi);
+}
+
+static VkCommandBuffer cmd(void)
+{
+	if (!g_cmd_open) {
+		cmd_begin(g_fr[g_slot].cmd);
+		g_cmd_open = 1;
+	}
+	return g_fr[g_slot].cmd;
+}
+
+static VkCommandBuffer upload_cmd(void)
+{
+	if (!g_up_open) {
+		cmd_begin(g_fr[g_slot].up);
+		g_up_open = 1;
+	}
+	return g_fr[g_slot].up;
+}
+
+/* Everything before it, done and visible to everything after it. Coarse, and enough: the title's frames are a few
+ * dozen passes. */
+static void barrier_all(VkCommandBuffer c)
+{
+	VkMemoryBarrier2 mb = {.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+	                       .srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+	                       .srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT,
+	                       .dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+	                       .dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT};
+	VkDependencyInfo d = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .memoryBarrierCount = 1,
+	                      .pMemoryBarriers = &mb};
+	vkCmdPipelineBarrier2(c, &d);
+}
+
+static void image_layout(VkCommandBuffer c, VkImage img, VkImageAspectFlags aspect, uint32_t levels,
+                         VkImageLayout from, VkImageLayout to)
+{
+	VkImageMemoryBarrier2 b = {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2,
+	                           .srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+	                           .srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT,
+	                           .dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+	                           .dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT,
+	                           .oldLayout = from, .newLayout = to,
+	                           .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+	                           .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .image = img,
+	                           .subresourceRange = {aspect, 0, levels, 0, 1}};
+	VkDependencyInfo d = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .imageMemoryBarrierCount = 1,
+	                      .pImageMemoryBarriers = &b};
+	vkCmdPipelineBarrier2(c, &d);
+}
+
+static void pass_end(void)
+{
+	if (!g_pass_open)
+		return;
+	vkCmdEndRendering(cmd());
+	g_pass_open = 0;
+	E.valid = 0;
+}
+
+static void frame_start(void)
+{
+	Frame *f = &g_fr[g_slot];
+	vkWaitForFences(g_dev, 1, &f->done, VK_TRUE, UINT64_MAX);
+	trace_frame_done(g_slot);
+	capture_frame_done(g_slot);
+	bury(f);
+	for (int i = 0; i < f->npools; i++)
+		vkResetDescriptorPool(g_dev, f->pools[i], 0);
+	f->pool_at = 0;
+	f->ring_head = 0;
+	g_set = VK_NULL_HANDLE;
+	g_have_verts = 0;
+}
+
+/* The upload and the frame's command buffers to the queue; with `wait`, until the GPU has done them. */
+static void submit(VkSemaphore wait_sem, VkSemaphore signal_sem, int wait)
+{
+	Frame *f = &g_fr[g_slot];
+	VkCommandBuffer bufs[2];
+	uint32_t n = 0;
+	pass_end();
+	if (g_up_open) {
+		barrier_all(f->up);
+		vkEndCommandBuffer(f->up);
+		bufs[n++] = f->up;
+		g_up_open = 0;
+	}
+	vkEndCommandBuffer(cmd());
+	bufs[n++] = f->cmd;
+	g_cmd_open = 0;
+	VkPipelineStageFlags stage = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+	VkSubmitInfo si = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO, .waitSemaphoreCount = wait_sem ? 1u : 0u,
+	                   .pWaitSemaphores = &wait_sem, .pWaitDstStageMask = &stage, .commandBufferCount = n,
+	                   .pCommandBuffers = bufs, .signalSemaphoreCount = signal_sem ? 1u : 0u,
+	                   .pSignalSemaphores = &signal_sem};
+	vkResetFences(g_dev, 1, &f->done);
+	VkResult r = vkQueueSubmit(g_queue, 1, &si, f->done);
+	if (r != VK_SUCCESS)
+		LOG("submit failed (%d)\n", r);
+	g_stamp++;
+	if (wait) {
+		vkWaitForFences(g_dev, 1, &f->done, VK_TRUE, UINT64_MAX);
+		f->ring_head = 0;              /* all of it read: the ring starts over */
+		g_set = VK_NULL_HANDLE;
+		g_have_verts = 0;
+		n_flushes++;
+	}
+}
+
+/* `n` bytes of this frame's ring, aligned; the ring full means the work so far is finished first. */
+static uint32_t ring_alloc(uint32_t n, void **p)
+{
+	Frame *f = &g_fr[g_slot];
+	uint32_t align = (uint32_t)g_limits.minUniformBufferOffsetAlignment;
+	if (align < 256)
+		align = 256;
+	uint32_t at = (f->ring_head + align - 1) & ~(align - 1);
+	if (n + UBO_RANGE > RING_BYTES)
+		return UINT32_MAX;
+	if (at + n + UBO_RANGE > RING_BYTES) {
+		uint32_t rt = g_cur_rt;
+		submit(VK_NULL_HANDLE, VK_NULL_HANDLE, 1);
+		g_cur_rt = rt;
+		at = 0;
+	}
+	f->ring_head = at + n;
+	*p = f->ring_map + at;
+	return at;
+}
