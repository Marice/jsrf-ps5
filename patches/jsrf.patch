+/* ---- memory ---------------------------------------------------------------------------------------------------- */
+
+static uint32_t mem_type(uint32_t bits, VkMemoryPropertyFlags want)
+{
+	for (uint32_t i = 0; i < g_memprops.memoryTypeCount; i++)
+		if ((bits & (1u << i)) && (g_memprops.memoryTypes[i].propertyFlags & want) == want)
+			return i;
+	return UINT32_MAX;
+}
+
+static VkDeviceMemory mem_alloc(VkMemoryRequirements req, VkMemoryPropertyFlags want)
+{
+	uint32_t type = mem_type(req.memoryTypeBits, want);
+	VkMemoryAllocateInfo ai = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .allocationSize = req.size,
+	                           .memoryTypeIndex = type};
+	VkDeviceMemory m = VK_NULL_HANDLE;
+	if (type == UINT32_MAX || vkAllocateMemory(g_dev, &ai, NULL, &m) != VK_SUCCESS) {
+		LOG("no memory for %llu bytes (types 0x%x)\n", (unsigned long long)req.size, req.memoryTypeBits);
+		return VK_NULL_HANDLE;
+	}
+	return m;
+}
+
+static int host_buffer(VkDeviceSize size, VkBufferUsageFlags usage, VkBuffer *buf, VkDeviceMemory *mem,
+                       uint8_t **map)
+{
+	VkBufferCreateInfo bi = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = size, .usage = usage};
+	if (vkCreateBuffer(g_dev, &bi, NULL, buf) != VK_SUCCESS)
+		return 0;
+	VkMemoryRequirements req;
+	vkGetBufferMemoryRequirements(g_dev, *buf, &req);
+	*mem = mem_alloc(req, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+	if (!*mem || vkBindBufferMemory(g_dev, *buf, *mem, 0) != VK_SUCCESS)
+		return 0;
+	return vkMapMemory(g_dev, *mem, 0, size, 0, (void **)map) == VK_SUCCESS;
+}
+
+/* Freed once the GPU can no longer be using it: when this frame slot comes round again. */
+static void defer(DeadKind kind, uint64_t handle)
+{
+	Frame *f = &g_fr[g_slot];
+	if (!handle)
+		return;
+	if (f->ndead == f->capdead) {
+		f->capdead = f->capdead ? f->capdead * 2 : 256;
+		f->dead = realloc(f->dead, (size_t)f->capdead * sizeof *f->dead);
+	}
+	f->dead[f->ndead++] = (Dead){kind, handle};
+}
+
+static void bury(Frame *f)
+{
+	for (int i = 0; i < f->ndead; i++) {
+		uint64_t h = f->dead[i].handle;
+		switch (f->dead[i].kind) {
+		case DEAD_IMAGE: vkDestroyImage(g_dev, (VkImage)h, NULL); break;
+		case DEAD_VIEW: vkDestroyImageView(g_dev, (VkImageView)h, NULL); break;
+		case DEAD_MEM: vkFreeMemory(g_dev, (VkDeviceMemory)h, NULL); break;
+		case DEAD_BUF: vkDestroyBuffer(g_dev, (VkBuffer)h, NULL); break;
+		case DEAD_PIPE: vkDestroyPipeline(g_dev, (VkPipeline)h, NULL); break;
+		case DEAD_MODULE: vkDestroyShaderModule(g_dev, (VkShaderModule)h, NULL); break;
+		}
+	}
+	f->ndead = 0;
+}
