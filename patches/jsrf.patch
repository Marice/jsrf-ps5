diff --git a/src/platform/win32_compat.c b/src/platform/win32_compat.c
index bb4f68d..ad3cd15 100644
--- a/src/platform/win32_compat.c
+++ b/src/platform/win32_compat.c
@@ -36,6 +36,18 @@
 #include <fcntl.h>
 #include <mach/mach.h>
 #include <mach/mach_host.h>
+#elif defined(JSRF_PS5)
+/* The PS5 (FreeBSD's kernel, Sony's libkernel): no sysinfo, no memfd_create.
+ * Address space is reserved with sceKernelReserveVirtualRange (a plain 4 GB
+ * PROT_NONE mmap is refused there, jsrf-ps5 decision log D2), and FreeBSD's
+ * MAP_FIXED | MAP_EXCL is Linux's MAP_FIXED_NOREPLACE. */
+#include <fcntl.h>
+#include <sys/stat.h>
+#define MAP_FIXED_NOREPLACE (MAP_FIXED | MAP_EXCL)
+int32_t sceKernelReserveVirtualRange(void **address, size_t length, int flags, size_t alignment);
+int64_t sceKernelGetDirectMemorySize(void);
+int32_t sceKernelAvailableDirectMemorySize(int64_t start, int64_t end, size_t alignment, int64_t *physical,
+                                           size_t *size);
 #else
 #include <sys/sysinfo.h>
 #if defined(__ANDROID__)
@@ -1450,9 +1462,15 @@ void *win32_reserve_address_space(void *base, size_t size)
 {
     void *p;
     if (g_reserved_n >= W32_MAX_RESERVATIONS) return NULL;
+#if defined(JSRF_PS5)
+    p = base;
+    if (sceKernelReserveVirtualRange(&p, size, base ? 0x10 /* fixed */ : 0, 64 * 1024) != 0)
+        return NULL;
+#else
     p = mmap(base, size, PROT_NONE,
              MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
     if (p == MAP_FAILED) return NULL;
+#endif
     if (base && p != base) { munmap(p, size); return NULL; }
     g_reserved[g_reserved_n].base = p;
     g_reserved[g_reserved_n].size = size;
@@ -1537,6 +1555,15 @@ LPVOID VirtualAlloc(LPVOID address, SIZE_T size, DWORD allocationType, DWORD pro
 #endif
     void *p = mmap(address, size, prot ? prot : PROT_READ | PROT_WRITE,
                    flags, -1, 0);
+#if defined(JSRF_PS5)
+    /* Anonymous memory is the title's flexible memory, a few hundred MB
+     * (jsrf-ps5 decision log D4): the big ones are logged. */
+    if (size >= (1u << 20)) {
+        fprintf(stderr, "  [VM] VirtualAlloc %zu KiB at %p: %s\n", (size_t)size / 1024,
+                address, p == MAP_FAILED ? strerror(errno) : (owned ? "inside the guest span" : "anonymous"));
+        fflush(stderr);
+    }
+#endif
     if (p == MAP_FAILED) { SetLastError(8); return NULL; }
 #if !defined(MAP_FIXED_NOREPLACE)
     if (owned) return p;
@@ -1685,7 +1712,7 @@ VOID DebugBreak(void) {
 
 VOID SecureZeroMemory(PVOID ptr, SIZE_T cnt)
 {
-#if defined(__APPLE__) || defined(__ANDROID__)
+#if defined(__APPLE__) || defined(__ANDROID__) || defined(JSRF_PS5)
     /* Darwin's memset_s is only declared when __STDC_WANT_LIB_EXT1__ is set
      * before every string.h in the translation unit, which is not something a
      * compat header can promise; Android's bionic has no explicit_bzero (and
@@ -1996,6 +2023,11 @@ static int anon_map_fd(const char *name)
             return fd;
         }
     }
+#elif defined(JSRF_PS5)
+    /* FreeBSD's unnamed shared memory: memfd_create's equivalent (checked on
+     * the console in phase 0, jsrf-ps5 decision log D2). */
+    (void)name;
+    return shm_open(SHM_ANON, O_RDWR | O_CREAT, 0600);
 #else
     return memfd_create(name ? name : "xbox_map", 0);
 #endif
@@ -2126,6 +2158,18 @@ BOOL GlobalMemoryStatusEx(LPMEMORYSTATUSEX b)
         b->ullTotalPageFile = b->ullTotalPhys;
         b->ullAvailPageFile = b->ullAvailPhys;
     }
+#elif defined(JSRF_PS5)
+    /* The title's direct memory: its size, and the largest block still free. */
+    {
+        int64_t physical = 0;
+        size_t largest = 0;
+        if (!b) return FALSE;
+        b->ullTotalPhys = (ULONGLONG)sceKernelGetDirectMemorySize();
+        sceKernelAvailableDirectMemorySize(0, (int64_t)b->ullTotalPhys, 0, &physical, &largest);
+        b->ullAvailPhys = largest;
+        b->ullTotalPageFile = b->ullTotalPhys;
+        b->ullAvailPageFile = b->ullAvailPhys;
+    }
 #else
     struct sysinfo si;
     if (!b) return FALSE;
