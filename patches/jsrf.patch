@@ -0,0 +1,3803 @@
+/*
+ * The NV2A renderer's device on Vulkan (nv2a_backend.h): the third backend,
+ * beside OpenGL (nv2a_gl/nv2a_gfx_gl.c) and Metal (nv2a_metal/nv2a_metal.m).
+ * Written for the PS5's Vulkan, Mesa's RADV on the console's GPU, reached
+ * without a loader (vk_icdGetInstanceProcAddr) and showing its pictures through
+ * VK_KHR_display -- the jsrf-ps5 port's (its decision log D32-D36) -- but it
+ * asks Vulkan 1.3 for nothing else, so it is not tied to that.
+ *
+ * How it maps the device interface:
+ *
+ * PROGRAMS are the front half's GLSL (lang GLSL), made Vulkan GLSL here before
+ * glslang turns them into SPIR-V: the loose uniforms of each stage become one
+ * std140 block whose layout comes from nv2a_uniform_desc (so uniform_f knows
+ * every offset without asking the compiler), the samplers get bindings, the
+ * varyings fixed locations by name, and NV2A_CLIP_Z01 is 1 -- Vulkan's clip
+ * volume runs z from 0 to w, as Metal's and the console's do.
+ *
+ * THE PICTURE IS THE WAY UP METAL HAS IT: targets hold the top row first and
+ * the viewport is given a negative height, so clip y = +1 is the top of the
+ * target, as the shaders put it, and the winding the title states is the one
+ * a GL viewport would see. rt_bottom_up is 0; scissors and clear rectangles
+ * come top-down and are used as they come.
+ *
+ * STATE: the blend, the colour mask, depth clamping, the program and the
+ * vertex layout are the pipeline (kept in a table); depth, stencil, culling,
+ * winding, scissor, viewport and topology are dynamic state.
+ *
+ * WORK is recorded into one command buffer a frame, with dynamic rendering: a
+ * pass begins on the bound target at its first draw or clear and ends where
+ * something has to happen outside one (a copy, a read, the flip). Textures are
+ * uploaded through a second command buffer submitted ahead of it. Two frames
+ * are in flight; everything the GPU may still read is freed two frames later.
+ */
+#define VK_NO_PROTOTYPES /* every entry point through vk_icdGetInstanceProcAddr: there is no loader */
+#include <vulkan/vulkan.h>
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+
+#include <glslang/Include/glslang_c_interface.h>
+#include <glslang/Public/resource_limits_c.h>
+
+#include "nv2a_backend.h"
+#if !defined(NV2A_VK_HOST)
+#include "nv2a_shader_cache.h"
+#endif
+#if __has_include(<glslang/build_info.h>)
+#include <glslang/build_info.h>
+#endif
+
+/* Where the capture and the replay keep their files: the title folder, or elsewhere when this file is built for a
+ * computer to replay a capture there (NV2A_VK_HOST, decision log D43). */
+#ifndef CAP_DIR
+#define CAP_DIR "/app0/vkcap"
+#endif
+
