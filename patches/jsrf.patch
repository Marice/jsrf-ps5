+/* ---- textures -------------------------------------------------------------------------------------------------- */
+
+static VkSampler sampler_for(const Nv2aSampler *s)
+{
+	static struct { uint32_t key; VkSampler smp; } cache[256];
+	static int n;
+	uint32_t key = (uint32_t)s->min_linear | s->mag_linear << 1 | (uint32_t)s->mip << 2 | (uint32_t)s->wrap_s << 4 |
+	               (uint32_t)s->wrap_t << 6 | (uint32_t)(s->aniso ? 1 : 0) << 8;
+	for (int i = 0; i < n; i++)
+		if (cache[i].key == key)
+			return cache[i].smp;
+	static const VkSamplerAddressMode wrap[3] = {VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_REPEAT,
+	                                             VK_SAMPLER_ADDRESS_MODE_MIRRORED_REPEAT};
+	VkSamplerCreateInfo si = {
+		.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+		.magFilter = s->mag_linear ? VK_FILTER_LINEAR : VK_FILTER_NEAREST,
+		.minFilter = s->min_linear ? VK_FILTER_LINEAR : VK_FILTER_NEAREST,
+		.mipmapMode = s->mip == 2 ? VK_SAMPLER_MIPMAP_MODE_LINEAR : VK_SAMPLER_MIPMAP_MODE_NEAREST,
+		.addressModeU = wrap[s->wrap_s < 3 ? s->wrap_s : 0],
+		.addressModeV = wrap[s->wrap_t < 3 ? s->wrap_t : 0],
+		.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+		.maxLod = s->mip ? VK_LOD_CLAMP_NONE : 0.0f,
+		.borderColor = VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK,
+	};
+	VkSampler smp = VK_NULL_HANDLE;
+	vkCreateSampler(g_dev, &si, NULL, &smp);
+	if (n < 256)
+		cache[n++] = (typeof(cache[0])){key, smp};
+	return smp;
+}
+
+static uint32_t tex_slot(void)
+{
+	static uint32_t next;
+	for (uint32_t k = 0; k < MAX_TEX; k++) {
+		uint32_t i = (next + k) % MAX_TEX;
+		if (!g_tex[i].used) {
+			next = i + 1;
+			memset(&g_tex[i], 0, sizeof g_tex[i]);
+			return i + 1;
+		}
+	}
+	LOG("out of textures\n");
+	return 0;
+}
+
+static int tex_ok(uint32_t h) { return h && h <= MAX_TEX && g_tex[h - 1].used; }
+static int rt_ok(uint32_t h) { return h && h <= MAX_RT && g_rt[h - 1].used; }
+
+static int image_new(VkTex *t, uint32_t w, uint32_t h, uint32_t levels, VkFormat fmt, VkImageUsageFlags usage,
+                     VkImageAspectFlags aspect, VkImage *img, VkImageView *view, VkDeviceMemory *mem)
+{
+	(void)t;
+	VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D,
+	                        .format = fmt, .extent = {w, h, 1}, .mipLevels = levels, .arrayLayers = 1,
+	                        .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL, .usage = usage,
+	                        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED};
+	if (vkCreateImage(g_dev, &ii, NULL, img) != VK_SUCCESS) {
+		LOG("could not make a %ux%u image\n", w, h);
+		return 0;
+	}
+	VkMemoryRequirements req;
+	vkGetImageMemoryRequirements(g_dev, *img, &req);
+	*mem = mem_alloc(req, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+	if (!*mem || vkBindImageMemory(g_dev, *img, *mem, 0) != VK_SUCCESS) {
+		LOG("no memory for a %ux%u image (%llu bytes)\n", w, h, (unsigned long long)req.size);
+		vkDestroyImage(g_dev, *img, NULL);
+		return 0;
+	}
+	VkImageViewCreateInfo vi = {.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .image = *img,
+	                            .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = fmt,
+	                            .subresourceRange = {aspect, 0, levels, 0, 1}};
+	if (vkCreateImageView(g_dev, &vi, NULL, view) != VK_SUCCESS) {
+		vkDestroyImage(g_dev, *img, NULL);
+		vkFreeMemory(g_dev, *mem, NULL);
+		return 0;
+	}
+	return 1;
+}
+
+static uint32_t mip_count(uint32_t w, uint32_t h)
+{
+	uint32_t n = 1;
+	while (w > 1 || h > 1) {
+		w = w > 1 ? w / 2 : 1;
+		h = h > 1 ? h / 2 : 1;
+		n++;
+	}
+	return n;
+}
+
+static uint32_t vk_tex_new(uint32_t w, uint32_t h, const void *rgba, const Nv2aSampler *s)
+{
+	uint32_t hnd = tex_slot();
+	if (!hnd || !w || !h)
+		return 0;
+	VkTex *t = &g_tex[hnd - 1];
+	uint32_t given = (s->mip && s->levels > 1) ? s->levels : 1;
+	uint32_t levels = s->mip ? (given > 1 ? given : mip_count(w, h)) : 1;
+	if (!image_new(t, w, h, levels, COLOR_FMT,
+	               VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+	               VK_IMAGE_ASPECT_COLOR_BIT, &t->image, &t->view, &t->mem))
+		return 0;
+	t->w = w;
+	t->h = h;
+	t->levels = levels;
+	t->smp = *s;
+	t->sampler = sampler_for(s);
+	t->used = 1;
+
+	/* the texels the title gave, every level of them, through the ring */
+	uint32_t bytes = 0, lw = w, lh = h;
+	for (uint32_t l = 0; l < given; l++) {
+		bytes += lw * lh * 4;
+		lw = lw > 1 ? lw / 2 : 1;
+		lh = lh > 1 ? lh / 2 : 1;
+	}
+	VkCommandBuffer c = upload_cmd();
+	image_layout(c, t->image, VK_IMAGE_ASPECT_COLOR_BIT, levels, VK_IMAGE_LAYOUT_UNDEFINED,
+	             VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+	if (rgba) {
+		void *p;
+		uint32_t at = ring_alloc(bytes, &p);
+		c = upload_cmd(); /* a full ring submitted the upload buffer too */
+		if (at == UINT32_MAX) {
+			LOG("a %ux%u texture is larger than the ring\n", w, h);
+		} else {
+			memcpy(p, rgba, bytes);
+			VkBufferImageCopy regions[16];
+			uint32_t off = at;
+			lw = w;
+			lh = h;
+			for (uint32_t l = 0; l < given && l < 16; l++) {
+				regions[l] = (VkBufferImageCopy){.bufferOffset = off,
+				                                 .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, l, 0, 1},
+				                                 .imageExtent = {lw, lh, 1}};
+				off += lw * lh * 4;
+				lw = lw > 1 ? lw / 2 : 1;
+				lh = lh > 1 ? lh / 2 : 1;
+			}
+			vkCmdCopyBufferToImage(c, g_fr[g_slot].ring, t->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+			                       given < 16 ? given : 16, regions);
+		}
+	}
+	/* the rest of the chain made from the level above, as glGenerateMipmap */
+	if (levels > given) {
+		image_layout(c, t->image, VK_IMAGE_ASPECT_COLOR_BIT, levels, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+		             VK_IMAGE_LAYOUT_GENERAL);
+		lw = w;
+		lh = h;
+		for (uint32_t l = 1; l < levels; l++) {
+			uint32_t nw = lw > 1 ? lw / 2 : 1, nh = lh > 1 ? lh / 2 : 1;
+			VkImageBlit b = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, l - 1, 0, 1},
+			                 .srcOffsets = {{0, 0, 0}, {(int32_t)lw, (int32_t)lh, 1}},
+			                 .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, l, 0, 1},
+			                 .dstOffsets = {{0, 0, 0}, {(int32_t)nw, (int32_t)nh, 1}}};
+			if (l >= given)
+				vkCmdBlitImage(c, t->image, VK_IMAGE_LAYOUT_GENERAL, t->image, VK_IMAGE_LAYOUT_GENERAL, 1, &b,
+				               VK_FILTER_LINEAR);
+			barrier_all(c);
+			lw = nw;
+			lh = nh;
+		}
+		image_layout(c, t->image, VK_IMAGE_ASPECT_COLOR_BIT, levels, VK_IMAGE_LAYOUT_GENERAL,
+		             VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	} else {
+		image_layout(c, t->image, VK_IMAGE_ASPECT_COLOR_BIT, levels, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+		             VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	}
+	n_tex++;
+	tex_bytes += bytes;
+	return hnd;
+}
+
+static void tex_destroy(uint32_t hnd)
+{
+	VkTex *t = &g_tex[hnd - 1];
+	defer(DEAD_VIEW, (uint64_t)t->view);
+	defer(DEAD_IMAGE, (uint64_t)t->image);
+	defer(DEAD_MEM, (uint64_t)t->mem);
+	t->used = 0;
+	for (int u = 0; u < 4; u++)
+		if (g_bound[u] == hnd)
+			g_bound[u] = 0;
+	g_set = VK_NULL_HANDLE;
+}
+
+static void vk_tex_free(uint32_t hnd)
+{
+	if (tex_ok(hnd) && !g_tex[hnd - 1].is_target && hnd != g_black)
+		tex_destroy(hnd);
+}
+
+static int vk_tex_read(uint32_t tex, uint32_t w, uint32_t h, void *bgra)
+{
+	(void)tex; (void)w; (void)h; (void)bgra;
+	return 0;
+}
+
+/* ---- render targets ------------------------------------------------------------------------------------------- */
+
+/* A colour image every use of a target can share a layout in: drawn into, sampled, copied. */
+static uint32_t color_image(uint32_t pw, uint32_t ph)
+{
+	uint32_t hnd = tex_slot();
+	if (!hnd)
+		return 0;
+	VkTex *t = &g_tex[hnd - 1];
+	Nv2aSampler s = {.min_linear = 1, .mag_linear = 1};
+	if (!image_new(t, pw, ph, 1, COLOR_FMT,
+	               VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+	                   VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+	               VK_IMAGE_ASPECT_COLOR_BIT, &t->image, &t->view, &t->mem))
+		return 0;
+	t->w = pw;
+	t->h = ph;
+	t->levels = 1;
+	t->sampler = sampler_for(&s);
+	t->used = 1;
+	t->is_target = 1;
+	return hnd;
+}
+
+static uint32_t vk_target_new(uint32_t pw, uint32_t ph)
+{
+	int i;
+	for (i = 0; i < MAX_RT; i++)
+		if (!g_rt[i].used)
+			break;
+	if (i == MAX_RT) {
+		LOG("out of render targets\n");
+		return 0;
+	}
+	VkRT *rt = &g_rt[i];
+	memset(rt, 0, sizeof *rt);
+	rt->color = color_image(pw, ph);
+	if (!rt->color)
+		return 0;
+	if (!image_new(NULL, pw, ph, 1, g_depth_fmt,
+	               VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+	                   VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+	               VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT, &rt->depth, &rt->depth_view,
+	               &rt->depth_mem)) {
+		tex_destroy(rt->color);
+		return 0;
+	}
+	rt->pw = pw;
+	rt->ph = ph;
+	rt->used = 1;
+	/* A new target reads as nothing until drawn: colour 0, depth 1, stencil 0, the way a driver's fresh
+	 * renderbuffer usually comes (as nv2a_metal.m's target_new). */
+	pass_end();
+	VkCommandBuffer c = cmd();
+	image_layout(c, g_tex[rt->color - 1].image, VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_UNDEFINED,
+	             VK_IMAGE_LAYOUT_GENERAL);
+	image_layout(c, rt->depth, VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT, 1, VK_IMAGE_LAYOUT_UNDEFINED,
+	             VK_IMAGE_LAYOUT_GENERAL);
+	VkClearColorValue cc = {{0, 0, 0, (jsrf_vk_modes & JSRF_VK_ALPHA1) ? 1.0f : 0.0f}};
+	VkClearDepthStencilValue dc = {g_zrev ? 0.0f : 1.0f, 0}; /* the far plane */
+	rt->dirty = 1;
+	VkImageSubresourceRange cr = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+	VkImageSubresourceRange dr = {VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT, 0, 1, 0, 1};
+	vkCmdClearColorImage(c, g_tex[rt->color - 1].image, VK_IMAGE_LAYOUT_GENERAL, &cc, 1, &cr);
+	vkCmdClearDepthStencilImage(c, rt->depth, VK_IMAGE_LAYOUT_GENERAL, &dc, 1, &dr);
+	barrier_all(c);
+	return (uint32_t)i + 1;
+}
+
+static void vk_target_free(uint32_t h)
+{
+	if (!rt_ok(h))
+		return;
+	VkRT *rt = &g_rt[h - 1];
+	if (g_cur_rt == h) {
+		pass_end();
+		g_cur_rt = 0;
+	}
+	tex_destroy(rt->color);
+	defer(DEAD_VIEW, (uint64_t)rt->depth_view);
+	defer(DEAD_IMAGE, (uint64_t)rt->depth);
+	defer(DEAD_MEM, (uint64_t)rt->depth_mem);
+	rt->used = 0;
+}
+
+static void vk_target_bind(uint32_t h)
+{
+	if (!rt_ok(h) || h == g_cur_rt)
+		return;
+	trace_bind(g_cur_rt, h);
+	pass_end();
+	g_cur_rt = h;
+	capture_bind(h);
+}
+
+static uint32_t vk_target_texture(uint32_t h)
+{
+	return rt_ok(h) ? g_rt[h - 1].color : 0;
+}
+
+/* The bound target's pass, begun where it is not: what the target holds is loaded and kept. */
+static int pass_begin(void)
+{
+	if (g_pass_open)
+		return 1;
+	if (!rt_ok(g_cur_rt))
+		return 0;
+	VkRT *rt = &g_rt[g_cur_rt - 1];
+	rt->dirty = 1;
+	VkCommandBuffer c = cmd();
+	barrier_all(c);
+	VkRenderingAttachmentInfo ca = {.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+	                                .imageView = g_tex[rt->color - 1].view, .imageLayout = VK_IMAGE_LAYOUT_GENERAL,
+	                                .loadOp = VK_ATTACHMENT_LOAD_OP_LOAD, .storeOp = VK_ATTACHMENT_STORE_OP_STORE};
+	VkRenderingAttachmentInfo da = {.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+	                                .imageView = rt->depth_view, .imageLayout = VK_IMAGE_LAYOUT_GENERAL,
+	                                .loadOp = VK_ATTACHMENT_LOAD_OP_LOAD, .storeOp = VK_ATTACHMENT_STORE_OP_STORE};
+	VkRenderingInfo ri = {.sType = VK_STRUCTURE_TYPE_RENDERING_INFO, .renderArea = {{0, 0}, {rt->pw, rt->ph}},
+	                      .layerCount = 1, .colorAttachmentCount = 1, .pColorAttachments = &ca,
+	                      .pDepthAttachment = &da, .pStencilAttachment = &da};
+	vkCmdBeginRendering(c, &ri);
+	/* clip y = +1 at the top row: a viewport turned over (see the head of this file) */
+	VkViewport vp = {0, (float)rt->ph, (float)rt->pw, -(float)rt->ph, 0.0f, 1.0f};
+	vkCmdSetViewport(c, 0, 1, &vp);
+	g_pass_open = 1;
+	E.valid = 0;
+	n_passes++;
+	return 1;
+}
+
+static uint32_t vk_target_snapshot(uint32_t h)
+{
+	if (!rt_ok(h))
+		return 0;
+	VkRT *rt = &g_rt[h - 1];
+	if (!tex_ok(g_snap) || g_tex[g_snap - 1].w != rt->pw || g_tex[g_snap - 1].h != rt->ph) {
+		if (tex_ok(g_snap)) {
+			g_tex[g_snap - 1].is_target = 0;
+			tex_destroy(g_snap);
+		}
+		pass_end();
+		g_snap = color_image(rt->pw, rt->ph);
+		if (!g_snap)
+			return 0;
+		image_layout(cmd(), g_tex[g_snap - 1].image, VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_UNDEFINED,
+		             VK_IMAGE_LAYOUT_GENERAL);
+	}
+	pass_end();
+	VkCommandBuffer c = cmd();
+	barrier_all(c);
+	VkImageCopy ic = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+	                  .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .extent = {rt->pw, rt->ph, 1}};
+	vkCmdCopyImage(c, g_tex[rt->color - 1].image, VK_IMAGE_LAYOUT_GENERAL, g_tex[g_snap - 1].image,
+	               VK_IMAGE_LAYOUT_GENERAL, 1, &ic);
+	barrier_all(c);
+	n_snaps++;
+	return g_snap;
+}
+
+/* An image's region into host memory, the GPU's work so far finished first. */
+static uint8_t *read_region(VkImage img, VkImageAspectFlags aspect, uint32_t x, uint32_t y, uint32_t w, uint32_t h,
+                            uint32_t bpp)
+{
+	static VkBuffer buf;
+	static VkDeviceMemory mem;
+	static uint8_t *map;
+	static uint32_t cap;
+	uint32_t bytes = w * h * bpp;
+	if (bytes > cap) {
+		if (buf) {
+			vkDeviceWaitIdle(g_dev);
+			vkDestroyBuffer(g_dev, buf, NULL);
+			vkFreeMemory(g_dev, mem, NULL);
+		}
+		cap = bytes < (4u << 20) ? (4u << 20) : bytes;
+		if (!host_buffer(cap, VK_BUFFER_USAGE_TRANSFER_DST_BIT, &buf, &mem, &map)) {
+			cap = 0;
+			buf = VK_NULL_HANDLE;
+			return NULL;
+		}
+	}
+	uint32_t rt = g_cur_rt;
+	pass_end();
+	VkCommandBuffer c = cmd();
+	barrier_all(c);
+	VkBufferImageCopy r = {.imageSubresource = {aspect, 0, 0, 1}, .imageOffset = {(int32_t)x, (int32_t)y, 0},
+	                       .imageExtent = {w, h, 1}};
+	vkCmdCopyImageToBuffer(c, img, VK_IMAGE_LAYOUT_GENERAL, buf, 1, &r);
+	barrier_all(c);
+	submit(VK_NULL_HANDLE, VK_NULL_HANDLE, 1);
+	g_cur_rt = rt;
+	n_reads++;
+	return map;
+}
+
+/* Colour back, rows bottom-up as glReadPixels gives them; (x, y) from the bottom-left. */
+static int vk_target_read(uint32_t h, uint32_t x, uint32_t y, uint32_t w, uint32_t ht, int bgra, void *out)
+{
+	if (!rt_ok(h) || !out || !w || !ht)
+		return 0;
+	VkRT *rt = &g_rt[h - 1];
+	if (x >= rt->pw || y >= rt->ph)
+		return 0;
+	if (x + w > rt->pw) w = rt->pw - x;
+	if (y + ht > rt->ph) ht = rt->ph - y;
+	uint8_t *p = read_region(g_tex[rt->color - 1].image, VK_IMAGE_ASPECT_COLOR_BIT, x, rt->ph - y - ht, w, ht, 4);
+	if (!p)
+		return 0;
+	uint8_t *o = out;
+	for (uint32_t row = 0; row < ht; row++) {
+		const uint8_t *src = p + (size_t)(ht - 1 - row) * w * 4;
+		uint8_t *dst = o + (size_t)row * w * 4;
+		if (!bgra) {
+			memcpy(dst, src, (size_t)w * 4);
+		} else {
+			for (uint32_t i = 0; i < w; i++) {
+				dst[i * 4 + 0] = src[i * 4 + 2];
+				dst[i * 4 + 1] = src[i * 4 + 1];
+				dst[i * 4 + 2] = src[i * 4 + 0];
+				dst[i * 4 + 3] = src[i * 4 + 3];
+			}
+		}
+	}
+	return 1;
+}
+
+static int vk_target_read_depth(uint32_t h, uint32_t pw, uint32_t ph, float *out)
+{
+	if (!rt_ok(h) || !out || g_depth_fmt != VK_FORMAT_D32_SFLOAT_S8_UINT)
+		return 0;
+	VkRT *rt = &g_rt[h - 1];
+	if (pw > rt->pw) pw = rt->pw;
+	if (ph > rt->ph) ph = rt->ph;
+	const float *p = (const float *)read_region(rt->depth, VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, pw, ph, 4);
+	if (!p)
+		return 0;
+	for (uint32_t row = 0; row < ph; row++)
+		memcpy(out + (size_t)row * pw, p + (size_t)(ph - 1 - row) * pw, (size_t)pw * 4);
+	return 1;
+}
+
+/* ---- programs: the front half's GLSL as Vulkan GLSL, then SPIR-V ---------------------------------------------- */
+
+typedef struct {
+	char *p;
+	size_t n, cap;
+} Str;
+
+static void str_add(Str *s, const char *t, size_t n)
+{
+	if (s->n + n + 1 > s->cap) {
+		s->cap = (s->n + n + 1) * 2;
+		s->p = realloc(s->p, s->cap);
+	}
+	memcpy(s->p + s->n, t, n);
+	s->n += n;
+	s->p[s->n] = 0;
+}
+
+static void str_fmt(Str *s, const char *fmt, ...)
+{
+	char buf[512];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(buf, sizeof buf, fmt, ap);
+	va_end(ap);
+	if (n > 0)
+		str_add(s, buf, (size_t)n < sizeof buf ? (size_t)n : sizeof buf - 1);
+}
+
+static int uniform_id(const char *name, int frag)
+{
+	for (int i = 0; i < NV2A_U_COUNT; i++)
+		if (nv2a_uniform_desc[i].name && nv2a_uniform_desc[i].frag == frag && !strcmp(nv2a_uniform_desc[i].name, name))
+			return i;
+	for (int i = 0; i < NV2A_U_COUNT; i++)
+		if (nv2a_uniform_desc[i].name && !strcmp(nv2a_uniform_desc[i].name, name))
+			return i;
+	return -1;
+}
+
+/* std140: where a member of this type and count goes after `at`, and the bytes it takes. */
+static uint32_t std140_place(int type, int count, uint32_t at, uint32_t *size)
+{
+	uint32_t align, sz;
+	int array = count > 1;
+	switch (type) {
+	case NV2A_UT_VEC2: align = 8; sz = 8; break;
+	case NV2A_UT_VEC3: align = 16; sz = 12; break;
+	case NV2A_UT_VEC4: align = 16; sz = 16; break;
+	case NV2A_UT_MAT2: align = 16; sz = 32; array = 1; break;
+	default: align = 4; sz = 4; break;
+	}
+	if (array) {
+		align = 16;
+		sz = (type == NV2A_UT_MAT2 ? 32u : 16u) * (uint32_t)(count > 1 ? count : 1);
+	}
+	at = (at + align - 1) & ~(align - 1);
+	*size = sz;
+	return at;
+}
+
+static const char *const kVaryings[] = {"oD0", "oD1", "oT0", "oT1", "oT2", "oT3", "oFogC", "oB0", "oB1", NULL};
+
+static int varying_location(const char *name)
+{
+	for (int i = 0; kVaryings[i]; i++)
+		if (!strcmp(kVaryings[i], name))
+			return i;
+	unsigned h = 0;
+	for (const char *p = name; *p; p++)
+		h = h * 31 + (unsigned char)*p;
+	return 10 + (int)(h % 20); /* a name this table does not know: the same in both stages */
+}
+
+/* Whether `word` occurs in [s, end): strstr would look on past the statement, into the next declaration. */
+static int has_word_part(const char *s, const char *end, const char *word)
+{
+	size_t n = strlen(word);
+	for (; s + n <= end; s++)
+		if (!memcmp(s, word, n))
+			return 1;
+	return 0;
+}
+
+static const char *skip_ws(const char *p)
+{
+	while (*p == ' ' || *p == '\t')
+		p++;
+	return p;
+}
+
+/* The last identifier before `end`, and an array count after it if there is one. */
+static void decl_name(const char *s, const char *end, char *name, size_t cap, int *count)
+{
+	const char *br = memchr(s, '[', (size_t)(end - s));
+	const char *e = br ? br : end;
+	while (e > s && (e[-1] == ' ' || e[-1] == '\t'))
+		e--;
+	const char *b = e;
+	while (b > s && (b[-1] == '_' || (b[-1] >= '0' && b[-1] <= '9') || (b[-1] >= 'a' && b[-1] <= 'z') ||
+	                 (b[-1] >= 'A' && b[-1] <= 'Z')))
+		b--;
+	size_t n = (size_t)(e - b) < cap - 1 ? (size_t)(e - b) : cap - 1;
+	memcpy(name, b, n);
+	name[n] = 0;
+	*count = br ? atoi(br + 1) : 1;
+}
+
+/*
+ * One stage's source, made Vulkan GLSL. Declarations are statements at the start of a line (as the emitters write
+ * them; a line can hold several, "in vec4 oD0; in vec4 oD1;"): a loose uniform is dropped and collected into the
+ * stage's block, put where the first one was; a sampler gets a binding; an in or out a location. `p` records the
+ * block's layout.
+ */
+static char *vulkanize(const char *src, int frag, VkProg *p, uint32_t *block_size)
+{
+	Str out = {0}, block = {0};
+	size_t block_at = (size_t)-1;
+	uint32_t at = 0;
+	int stage = frag ? 1 : 0;
+	const char *line = src;
+	int first = 1;
+	while (*line) {
+		const char *eol = strchr(line, '\n');
+		if (!eol)
+			eol = line + strlen(line);
+		if (first) {
+			/* the version line: 450, which takes explicit locations and bindings */
+			str_add(&out, "#version 450\n", 13);
+			/* The position computed exactly as written (D42): RADV may fuse a multiply and an add into one
+			 * instruction, which rounds differently, and not alike in every program -- a decal drawn by a vertex
+			 * program over a wall drawn by the fixed-function transform then lands a hair behind the wall's depth
+			 * and loses the depth test pixel by pixel (the graffiti). */
+			if (!frag)
+				str_add(&out, "precise gl_Position;\n", 21);
+			first = 0;
+			line = *eol ? eol + 1 : eol;
+			continue;
+		}
+		const char *t = skip_ws(line);
+		if (!strncmp(t, "#define NV2A_CLIP_Z01 0", 22)) {
+			str_add(&out, "#define NV2A_CLIP_Z01 1\n", 24);
+			line = *eol ? eol + 1 : eol;
+			continue;
+		}
+		if (*t == '#' || !(!strncmp(t, "uniform ", 8) || !strncmp(t, "in ", 3) || !strncmp(t, "out ", 4) ||
+		                   !strncmp(t, "flat ", 5) || !strncmp(t, "smooth ", 7) || !strncmp(t, "noperspective ", 14))) {
+			/* ... and every value on the way to it: a local float variable of the vertex stage made precise (an
+			 * indented declaration, not a function's head). */
+			if (!frag && t > line &&
+			    (!strncmp(t, "vec4 ", 5) || !strncmp(t, "vec3 ", 5) || !strncmp(t, "vec2 ", 5) || !strncmp(t, "float ", 6))) {
+				const char *e = t;
+				while (e < eol && *e != '=' && *e != ';' && *e != '(')
+					e++;
+				if (e < eol && *e != '(')
+					str_add(&out, "precise ", 8);
+			}
+			str_add(&out, line, (size_t)(eol - line) + (*eol ? 1 : 0));
+			line = *eol ? eol + 1 : eol;
+			continue;
+		}
+		/* statements of this line */
+		const char *s = line;
+		while (s < eol) {
+			const char *semi = memchr(s, ';', (size_t)(eol - s));
+			const char *end = semi ? semi : eol;
+			const char *st = skip_ws(s);
+			char name[512];
+			int count = 1;
+			if (st >= end) {
+				s = end + (semi ? 1 : 0);
+				continue;
+			}
+			if (!strncmp(st, "uniform ", 8) && semi) {
+				decl_name(st, end, name, sizeof name, &count);
+				if (has_word_part(st, end, "sampler")) { /* within this statement only */
+					int unit = (!strncmp(name, "tex", 3) && name[3] >= '0' && name[3] <= '3') ? name[3] - '0' : 0;
+					p->samplers |= 1u << unit;
+					str_fmt(&out, "layout(set = 0, binding = %d) ", 2 + unit);
+					str_add(&out, st, (size_t)(end - st) + 1);
+				} else {
+					int id = uniform_id(name, frag);
+					if (id >= 0 && p->off[stage][id] < 0) {
+						const Nv2aUniformDesc *d = &nv2a_uniform_desc[id];
+						uint32_t size;
+						uint32_t o = std140_place(d->type, d->count, at, &size);
+						p->off[stage][id] = (int32_t)o;
+						at = o + size;
+						str_fmt(&block, "    layout(offset = %u) ", o);
+						str_add(&block, st + 8, (size_t)(end - st - 8));
+						str_add(&block, ";\n", 2);
+						if (block_at == (size_t)-1)
+							block_at = out.n;
+					} else if (id < 0) {
+						LOG("uniform %s is not in the table: left out\n", name);
+					}
+				}
+			} else if (semi && (!strncmp(st, "in ", 3) || !strncmp(st, "out ", 4) || !strncmp(st, "flat ", 5) ||
+			                    !strncmp(st, "smooth ", 7) || !strncmp(st, "noperspective ", 14))) {
+				decl_name(st, end, name, sizeof name, &count);
+				int loc = (frag && strstr(st, "out ") == st) ? 0 : varying_location(name);
+				if (frag && (!strncmp(st, "out ", 4)))
+					loc = 0;
+				str_fmt(&out, "layout(location = %d) ", loc);
+				str_add(&out, st, (size_t)(end - st) + 1);
+			} else {
+				str_add(&out, s, (size_t)(end - s) + (semi ? 1 : 0));
+			}
+			s = end + (semi ? 1 : 0);
+		}
+		str_add(&out, "\n", 1);
+		line = *eol ? eol + 1 : eol;
+	}
+	*block_size = (at + 15) & ~15u;
+	if (block.n) {
+		Str whole = {0};
+		str_add(&whole, out.p, block_at);
+		str_fmt(&whole, "layout(std140, set = 0, binding = %d) uniform Nv2a%s {\n", frag, frag ? "FU" : "VU");
+		str_add(&whole, block.p, block.n);
+		str_add(&whole, "};\n", 3);
+		str_add(&whole, out.p + block_at, out.n - block_at);
+		free(out.p);
+		out = whole;
+	}
+	free(block.p);
+	return out.p;
+}
+
+/* A stage's GLSL as SPIR-V: the words (malloc'd, `*words` of them), or NULL. */
+static uint32_t *compile_spirv(const char *src, glslang_stage_t stage, const char *what, size_t *words)
+{
+	const glslang_input_t input = {
+		.language = GLSLANG_SOURCE_GLSL, .stage = stage, .client = GLSLANG_CLIENT_VULKAN,
+		.client_version = GLSLANG_TARGET_VULKAN_1_3, .target_language = GLSLANG_TARGET_SPV,
+		.target_language_version = GLSLANG_TARGET_SPV_1_6, .code = src, .default_version = 450,
+		.default_profile = GLSLANG_CORE_PROFILE,
+		.messages = GLSLANG_MSG_DEFAULT_BIT | GLSLANG_MSG_SPV_RULES_BIT | GLSLANG_MSG_VULKAN_RULES_BIT,
+		.resource = glslang_default_resource(),
+	};
+	glslang_shader_t *sh = glslang_shader_create(&input);
+	glslang_shader_set_options(sh, GLSLANG_SHADER_AUTO_MAP_BINDINGS | GLSLANG_SHADER_AUTO_MAP_LOCATIONS);
+	uint32_t *code = NULL;
+	*words = 0;
+	if (!glslang_shader_preprocess(sh, &input) || !glslang_shader_parse(sh, &input)) {
+		LOG("%s %s shader: %s\n", what, stage == GLSLANG_STAGE_VERTEX ? "vertex" : "fragment",
+		    glslang_shader_get_info_log(sh));
+		static int shown;
+		if (shown++ < 3)
+			fprintf(stderr, "----\n%s\n----\n", src);
+		glslang_shader_delete(sh);
+		return NULL;
+	}
+	glslang_program_t *pr = glslang_program_create();
+	glslang_program_add_shader(pr, sh);
+	if (!glslang_program_link(pr, GLSLANG_MSG_SPV_RULES_BIT | GLSLANG_MSG_VULKAN_RULES_BIT) ||
+	    !glslang_program_map_io(pr)) {
+		LOG("%s: link: %s\n", what, glslang_program_get_info_log(pr));
+	} else {
+		glslang_program_SPIRV_generate(pr, stage);
+		*words = glslang_program_SPIRV_get_size(pr);
+		if ((code = malloc(*words * 4)) != NULL)
+			glslang_program_SPIRV_get(pr, code);
+		else
+			*words = 0;
+	}
+	glslang_program_delete(pr);
+	glslang_shader_delete(sh);
+	return code;
+}
+
+static VkShaderModule make_module(const uint32_t *code, size_t words, const char *what)
+{
+	VkShaderModule m = VK_NULL_HANDLE;
+	VkShaderModuleCreateInfo mi = {.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO, .codeSize = words * 4,
+	                               .pCode = code};
+	if (!code || !words || vkCreateShaderModule(g_dev, &mi, NULL, &m) != VK_SUCCESS) {
+		LOG("%s: no shader module\n", what);
+		return VK_NULL_HANDLE;
+	}
+	return m;
+}
+
+/* One stage, compiled now (the frame replay's). */
+static VkShaderModule compile_stage(const char *src, glslang_stage_t stage, const char *what)
+{
+	size_t words = 0;
+	uint32_t *code = compile_spirv(src, stage, what, &words);
+	VkShaderModule m = code ? make_module(code, words, what) : VK_NULL_HANDLE;
+	free(code);
+	return m;
+}
+
+/* ---- the shader cache (nv2a_shader_cache.h, decision log D58) --------------------------------------------------
+ *
+ * The front half keeps every program as the pair of GLSL sources it was made from, and before the game starts adds
+ * the ones the engine's seed lists (seed_import). What costs here is glslang (~8 ms a program on the console, D58),
+ * so the SPIR-V of both stages is kept as the program's "binary": a program the cache has costs two shader modules
+ * the next time it is asked for. The SPIR-V depends on glslang and on vulkanize, not on the GPU's driver, so those
+ * two name it (VK_SPIRV_FORMAT: raise it when vulkanize changes what it writes). A record is [vertex words][fragment
+ * words][the vertex SPIR-V][the fragment SPIR-V]. Programs with no SPIR-V yet are compiled once, all of them, when
+ * the cache opens, before the game starts (Marice's choice, D58). RADV's pipeline cache goes to a file of its own,
+ * read at that moment and written on a frame with little to draw when pipelines were added, at most once a minute:
+ * the title folder is on the console's SSD. */
+#define VK_SPIRV_FORMAT 1u
+#define PIPE_SAVE_EVERY_MS 60000.0
+static int g_spv_ok;                    /* SPIR-V kept in the cache */
+static char g_pipe_file[1100];
+static uint64_t g_pipes_saved = ~0ull;  /* n_pipes when the file was last written (~0: never read) */
+static double g_pipes_saved_ms;
+
+static void vulkanize_pair(const char *vsrc, const char *fsrc, VkProg *p, char **vs, char **fs)
+{
+	memset(p, 0, sizeof *p);
+	for (int s = 0; s < 2; s++)
+		for (int u = 0; u < NV2A_U_COUNT; u++)
+			p->off[s][u] = -1;
+	*vs = vulkanize(vsrc, 0, p, &p->vu_size);
+	*fs = vulkanize(fsrc, 1, p, &p->fu_size);
+}
+
+/* Both stages' SPIR-V as one record (malloc'd, `*len` bytes), or NULL if either does not compile. */
+static void *spirv_pair(const char *vs, const char *fs, const char *what, uint32_t *len)
+{
+	size_t vw = 0, fw = 0;
+	uint32_t *v = compile_spirv(vs, GLSLANG_STAGE_VERTEX, what, &vw);
+	uint32_t *f = v ? compile_spirv(fs, GLSLANG_STAGE_FRAGMENT, what, &fw) : NULL;
+	uint32_t *rec = (v && f) ? malloc((2 + vw + fw) * 4) : NULL;
+	if (rec) {
+		rec[0] = (uint32_t)vw;
+		rec[1] = (uint32_t)fw;
+		memcpy(rec + 2, v, vw * 4);
+		memcpy(rec + 2 + vw, f, fw * 4);
+		*len = (uint32_t)((2 + vw + fw) * 4);
+	}
+	free(v);
+	free(f);
+	return rec;
+}
+
+/* A record's two modules; 0 if it is damaged or a module will not make. */
+static int modules_from(const void *data, uint32_t len, VkProg *p, const char *what)
+{
+	const uint32_t *rec = data;
+	if (!rec || len < 8 || (uint64_t)(2 + (uint64_t)rec[0] + rec[1]) * 4 != len || !rec[0] || !rec[1])
+		return 0;
+	p->vs = make_module(rec + 2, rec[0], what);
+	p->fs = p->vs ? make_module(rec + 2 + rec[0], rec[1], what) : VK_NULL_HANDLE;
+	if (!p->fs && p->vs) {
+		vkDestroyShaderModule(g_dev, p->vs, NULL);
+		p->vs = VK_NULL_HANDLE;
+	}
+	return p->vs != VK_NULL_HANDLE;
+}
+
+#if !defined(NV2A_VK_HOST)
+static void pipes_load(const char *dir)
+{
+	snprintf(g_pipe_file, sizeof g_pipe_file, "%s/pipelines-vulkan.dat", dir);
+	g_pipes_saved = n_pipes;
+	g_pipes_saved_ms = now_ms();
+	FILE *f = fopen(g_pipe_file, "rb");
+	if (!f) {
+		fprintf(stderr, "  [SHADERS] Vulkan: no saved pipelines yet (%s)\n", g_pipe_file);
+		return;
+	}
+	long end = (!fseek(f, 0, SEEK_END)) ? ftell(f) : -1;
+	rewind(f);
+	void *data = (end > 0 && end < (256L << 20)) ? malloc((size_t)end) : NULL;
+	if (data && fread(data, 1, (size_t)end, f) == (size_t)end) {
+		VkPipelineCacheCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO,
+		                                .initialDataSize = (size_t)end, .pInitialData = data};
+		VkPipelineCache loaded = VK_NULL_HANDLE;
+		VkResult r = vkCreatePipelineCache(g_dev, &ci, NULL, &loaded);
+		if (r == VK_SUCCESS)
+			r = vkMergePipelineCaches(g_dev, g_pipe_cache, 1, &loaded);
+		if (loaded)
+			vkDestroyPipelineCache(g_dev, loaded, NULL);
+		fprintf(stderr, "  [SHADERS] Vulkan: saved pipelines read, %ld KB (%s)\n", end >> 10,
+		        r == VK_SUCCESS ? "merged" : "refused");
+	}
+	free(data);
+	fclose(f);
+}
+
+static void pipes_save(void)
+{
+	size_t size = 0;
+	if (!g_pipe_file[0] || vkGetPipelineCacheData(g_dev, g_pipe_cache, &size, NULL) != VK_SUCCESS || !size)
+		return;
+	void *data = malloc(size);
+	char tmp[1110];
+	snprintf(tmp, sizeof tmp, "%s.new", g_pipe_file);
+	FILE *f = NULL;
+	int ok = data && vkGetPipelineCacheData(g_dev, g_pipe_cache, &size, data) == VK_SUCCESS &&
+	         (f = fopen(tmp, "wb")) != NULL && fwrite(data, 1, size, f) == size;
+	if (f && fclose(f))
+		ok = 0;
+	if (ok)
+		ok = rename(tmp, g_pipe_file) == 0;
+	else if (f)
+		remove(tmp);
+	free(data);
+	g_pipes_saved = n_pipes;
+	g_pipes_saved_ms = now_ms();
+	fprintf(stderr, "  [SHADERS] Vulkan: %llu pipelines written, %zu KB%s\n", (unsigned long long)n_pipes, size >> 10,
+	        ok ? "" : " -- failed");
+}
+
+static void vk_cache_open(const char *dir, const char *tag)
+{
+	char drv[128];
+	if (!nv2a_sc_open(dir, tag))
+		return;
+#if defined(GLSLANG_VERSION_MAJOR)
+	snprintf(drv, sizeof drv, "SPIR-V|glslang %d.%d.%d|vulkanize %u", GLSLANG_VERSION_MAJOR, GLSLANG_VERSION_MINOR,
+	         GLSLANG_VERSION_PATCH, VK_SPIRV_FORMAT);
+#else
+	snprintf(drv, sizeof drv, "SPIR-V|glslang|vulkanize %u", VK_SPIRV_FORMAT);
+#endif
+	g_spv_ok = nv2a_sc_bin_open(drv);
+	pipes_load(dir);
+	if (!g_spv_ok)
+		return;
+	/* every program without SPIR-V: compiled now, before the game starts (D58) */
+	const double t0 = now_ms();
+	int n = nv2a_sc_count(), built = 0, failed = 0, have = 0;
+	for (int i = 0; i < n; i++) {
+		uint64_t key;
+		const char *v, *f;
+		if (!nv2a_sc_entry(i, &key, &v, &f))
+			continue;
+		if (nv2a_sc_bin_has(key)) {
+			have++;
+			continue;
+		}
+		VkProg scratch;
+		char *vs, *fs;
+		uint32_t len = 0;
+		vulkanize_pair(v, f, &scratch, &vs, &fs);
+		void *rec = (vs && fs) ? spirv_pair(vs, fs, "a cached program", &len) : NULL;
+		if (rec) {
+			nv2a_sc_bin_put(key, rec, len, VK_SPIRV_FORMAT);
+			built++;
+		} else {
+			failed++;
+		}
+		free(rec);
+		free(vs);
+		free(fs);
+	}
+	fprintf(stderr, "  [SHADERS] Vulkan: %d programs in the cache, %d with SPIR-V already, %d compiled now in %.0f ms"
+	        "%s\n", n, have, built, now_ms() - t0, failed ? " (some would not compile)" : "");
+	fflush(stderr);
+}
+
+/* Called on frames with little to draw: the pipelines to their file, when some were added and a minute has gone.
+ * Always "more to do", so that it keeps being called. */
+static int vk_cache_idle(double budget_ms)
+{
+	(void)budget_ms;
+	if (g_pipe_file[0] && n_pipes != g_pipes_saved && now_ms() - g_pipes_saved_ms >= PIPE_SAVE_EVERY_MS)
+		pipes_save();
+	return 1;
+}
+#endif
+
+/* Programs that did not compile, by a hash of both sources: the front half asks again on every draw that needs one,
+ * and compiling a failing pair thousands of times a second starved the game, its sound included (D36). */
+#define FAILED_SLOTS 4096
+static uint64_t g_failed[FAILED_SLOTS];
+
+static uint64_t source_hash(const char *a, const char *b)
+{
+	uint64_t h = 1469598103934665603ull;
+	for (const char *s = a; *s; s++)
+		h = (h ^ (unsigned char)*s) * 1099511628211ull;
+	h = (h ^ 0xff) * 1099511628211ull;
+	for (const char *s = b; *s; s++)
+		h = (h ^ (unsigned char)*s) * 1099511628211ull;
+	return h ? h : 1;
+}
+
+static uint32_t vk_prog_new(const char *vsrc, const char *fsrc, const char *what)
+{
+	int i;
+	const uint64_t hash = source_hash(vsrc, fsrc);
+	if (g_failed[hash % FAILED_SLOTS] == hash)
+		return 0;
+	for (i = 0; i < MAX_PROG; i++)
+		if (!g_prog[i].used)
+			break;
+	if (i == MAX_PROG) {
+		LOG("out of programs\n");
+		return 0;
+	}
+	double t0 = now_ms();
+	VkProg *p = &g_prog[i];
+	char *vs, *fs;
+	vulkanize_pair(vsrc, fsrc, p, &vs, &fs);
+	for (int a = 0; a < 16; a++) {
+		char pat[48];
+		snprintf(pat, sizeof pat, "in vec4 v%d;", a);
+		if (strstr(vsrc, pat))
+			p->inputs |= 1u << a;
+	}
+	what = what ? what : "program";
+	int from_cache = 0;
+#if !defined(NV2A_VK_HOST)
+	/* the SPIR-V the cache keeps, by the key of the front half's sources (D58) */
+	const uint64_t key = (g_spv_ok && nv2a_sc_is_open()) ? nv2a_sc_key(vsrc, fsrc) : 0;
+	if (key && nv2a_sc_bin_has(key)) {
+		uint32_t len = 0, format = 0;
+		void *rec = nv2a_sc_bin_get(key, &len, &format);
+		from_cache = format == VK_SPIRV_FORMAT && modules_from(rec, len, p, what);
+		free(rec);
+		if (!from_cache)
+			nv2a_sc_bin_drop(key);
+	}
+#endif
+	if (!from_cache && vs && fs) {
+		uint32_t len = 0;
+		void *rec = spirv_pair(vs, fs, what, &len);
+		if (rec && modules_from(rec, len, p, what)) {
+#if !defined(NV2A_VK_HOST)
+			if (key) {
+				nv2a_sc_add(key, vsrc, fsrc);
+				nv2a_sc_bin_put(key, rec, len, VK_SPIRV_FORMAT);
+			}
+#endif
+		}
+		free(rec);
+	}
+	p->src_v = vs; /* kept for the frame capture; freed with the program */
+	p->src_f = fs;
+	if (!p->vs || !p->fs) {
+		free(p->src_v);
+		free(p->src_f);
+		p->src_v = p->src_f = NULL;
+		if (p->vs) vkDestroyShaderModule(g_dev, p->vs, NULL);
+		g_failed[hash % FAILED_SLOTS] = hash;
+		return 0;
+	}
+	p->vu = calloc(1, p->vu_size ? p->vu_size : 16);
+	p->fu = calloc(1, p->fu_size ? p->fu_size : 16);
+	p->dirty_v = p->dirty_f = 1;
+	p->used = 1;
+	n_progs++;
+	n_progs_cached += from_cache;
+	ms_progs += now_ms() - t0;
+	return (uint32_t)i + 1;
+}
+
+static int prog_ok(uint32_t h) { return h && h <= MAX_PROG && g_prog[h - 1].used; }
+
+static void vk_prog_free(uint32_t h)
+{
+	if (!prog_ok(h))
+		return;
+	VkProg *p = &g_prog[h - 1];
+	for (uint32_t i = 0; i < PIPE_SLOTS; i++)
+		if (g_pipes[i].used && g_pipes[i].key.prog == h) {
+			defer(DEAD_PIPE, (uint64_t)g_pipes[i].pipe);
+			g_pipes[i].used = 2; /* a tombstone: lookups go past it */
+		}
+	defer(DEAD_MODULE, (uint64_t)p->vs);
+	defer(DEAD_MODULE, (uint64_t)p->fs);
+	free(p->vu);
+	free(p->fu);
+	free(p->src_v);
+	free(p->src_f);
+	p->src_v = p->src_f = NULL;
+	p->used = 0;
+	if (g_cur_prog == h)
+		g_cur_prog = 0;
+}
+
+static int vk_prog_uses(uint32_t h, int id)
+{
+	if (!prog_ok(h) || id < 0 || id >= NV2A_U_COUNT)
+		return 0;
+	if (id >= NV2A_U_TEX0 && id < NV2A_U_TEX0 + 4)
+		return (g_prog[h - 1].samplers >> (id - NV2A_U_TEX0)) & 1;
+	return g_prog[h - 1].off[0][id] >= 0 || g_prog[h - 1].off[1][id] >= 0;
+}
+
+static void vk_prog_use(uint32_t h)
+{
+	if (prog_ok(h))
+		g_cur_prog = h;
+}
+
+/* Elements first .. first+n-1 of uniform `id` into the program's blocks, laid out as std140 has them. */
+static void put_uniform(VkProg *p, int id, int first, const float *v, int n)
+{
+	const Nv2aUniformDesc *d = &nv2a_uniform_desc[id];
+	for (int s = 0; s < 2; s++) {
+		int32_t off = p->off[s][id];
+		if (off < 0)
+			continue;
+		uint8_t *base = s ? p->fu : p->vu;
+		uint32_t size = s ? p->fu_size : p->vu_size;
+		int comps, stride;
+		switch (d->type) {
+		case NV2A_UT_VEC2: comps = 2; break;
+		case NV2A_UT_VEC3: comps = 3; break;
+		case NV2A_UT_VEC4: comps = 4; break;
+		case NV2A_UT_MAT2: comps = 4; break;
+		default: comps = 1; break;
+		}
+		stride = d->type == NV2A_UT_MAT2 ? 32 : (d->count > 1 ? 16 : comps * 4);
+		for (int e = 0; e < n && first + e < d->count; e++) {
+			uint32_t at = (uint32_t)off + (uint32_t)(first + e) * (uint32_t)stride;
+			const float *src = v + e * comps;
+			if (d->type == NV2A_UT_MAT2) {
+				if (at + 32 > size) break;
+				memcpy(base + at, src, 8);
+				memcpy(base + at + 16, src + 2, 8);
+			} else {
+				if (at + (uint32_t)comps * 4 > size) break;
+				memcpy(base + at, src, (size_t)comps * 4);
+			}
+		}
+		if (s) p->dirty_f = 1; else p->dirty_v = 1;
+	}
+}
+
+static void vk_uniform_f(int id, const float *v, int n)
+{
+	if (!prog_ok(g_cur_prog) || id < 0 || id >= NV2A_U_COUNT || !v)
+		return;
+	put_uniform(&g_prog[g_cur_prog - 1], id, 0, v, n);
+}
+
+static int vk_uniform_f_part(int id, int first, const float *v, int n)
+{
+	if (!prog_ok(g_cur_prog) || id < 0 || id >= NV2A_U_COUNT || !v)
+		return 1;
+	put_uniform(&g_prog[g_cur_prog - 1], id, first, v, n);
+	return 1;
+}
+
+static void vk_uniform_i(int id, int v)
+{
+	if (!prog_ok(g_cur_prog) || id < 0 || id >= NV2A_U_COUNT)
+		return;
+	if (id >= NV2A_U_TEX0 && id < NV2A_U_TEX0 + 4)
+		return; /* sampler units: the bindings say */
+	VkProg *p = &g_prog[g_cur_prog - 1];
+	for (int s = 0; s < 2; s++) {
+		int32_t off = p->off[s][id];
+		uint32_t size = s ? p->fu_size : p->vu_size;
+		if (off < 0 || (uint32_t)off + 4 > size)
+			continue;
+		int32_t iv = v;
+		memcpy((s ? p->fu : p->vu) + off, &iv, 4);
+		if (s) p->dirty_f = 1; else p->dirty_v = 1;
+	}
+}
+
+static void vk_texture(int unit, uint32_t tex)
+{
+	if (unit < 0 || unit > 3)
+		return;
+	g_bound[unit] = tex;
+}
+
+static void vk_state(const Nv2aRenderState *rs) { g_rs = *rs; }
+static void vk_state_invalidate(void) { E.valid = 0; }
+
+/* ---- vertices, pipelines, draws ------------------------------------------------------------------------------- */
+
+static void vk_vertices_body(const float *v, uint32_t nverts, uint32_t stride_floats, const int attr_at[16],
+                             uint32_t const_mask, const float const_attr[16][4]);
+static uint64_t tsc_backend_v;
+static void vk_vertices(const float *v, uint32_t nverts, uint32_t stride_floats, const int attr_at[16],
+                        uint32_t const_mask, const float const_attr[16][4])
+{
+	uint64_t t0 = __builtin_ia32_rdtsc();
+	vk_vertices_body(v, nverts, stride_floats, attr_at, const_mask, const_attr);
+	tsc_backend_v += __builtin_ia32_rdtsc() - t0;
+}
+
+static void vk_vertices_body(const float *v, uint32_t nverts, uint32_t stride_floats, const int attr_at[16],
+                             uint32_t const_mask, const float const_attr[16][4])
+{
+	uint32_t bytes = nverts * stride_floats * 4;
+	void *p;
+	g_have_verts = 0;
+	g_vb_buf = VK_NULL_HANDLE;
+	if (bytes) {
+		uint32_t at = ring_alloc(bytes, &p);
+		if (at == UINT32_MAX)
+			return;
+		memcpy(p, v, bytes);
+		g_vb_off = at;
+	}
+	g_vb_stride = stride_floats;
+	for (int i = 0; i < 16; i++) {
+		g_vb_at[i] = (int16_t)(bytes ? attr_at[i] : -1);
+		if (attr_at[i] < 0 && (const_mask & (1u << i)))
+			memcpy(g_generic[i], const_attr[i], 16);
+	}
+	/* the values of the attributes without an array: one vec4 each, read with a stride of 0 */
+	uint32_t at = ring_alloc(sizeof g_generic, &p);
+	if (at == UINT32_MAX)
+		return;
+	memcpy(p, g_generic, sizeof g_generic);
+	g_cb_off = at;
+	g_have_verts = 1;
+}
+
+static VkBlendFactor blend_of(uint32_t f)
+{
+	switch (f) {
+	case 0x0000: return VK_BLEND_FACTOR_ZERO;
+	case 0x0001: return VK_BLEND_FACTOR_ONE;
+	case 0x0300: return VK_BLEND_FACTOR_SRC_COLOR;
+	case 0x0301: return VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR;
+	case 0x0302: return VK_BLEND_FACTOR_SRC_ALPHA;
+	case 0x0303: return VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+	case 0x0304: return VK_BLEND_FACTOR_DST_ALPHA;
+	case 0x0305: return VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA;
+	case 0x0306: return VK_BLEND_FACTOR_DST_COLOR;
+	case 0x0307: return VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR;
+	case 0x0308: return VK_BLEND_FACTOR_SRC_ALPHA_SATURATE;
+	default: return VK_BLEND_FACTOR_ONE;
+	}
+}
+
+static VkCompareOp cmp_of(uint32_t gl)
+{
+	return (gl >= 0x200 && gl <= 0x207) ? (VkCompareOp)(gl - 0x200) : VK_COMPARE_OP_LESS_OR_EQUAL;
+}
+
+static VkStencilOp sop_of(uint32_t v)
+{
+	switch (v) {
+	case 0x0000: return VK_STENCIL_OP_ZERO;
+	case 0x1E01: return VK_STENCIL_OP_REPLACE;
+	case 0x1E02: return VK_STENCIL_OP_INCREMENT_AND_CLAMP;
+	case 0x1E03: return VK_STENCIL_OP_DECREMENT_AND_CLAMP;
+	case 0x150A: return VK_STENCIL_OP_INVERT;
+	case 0x8507: return VK_STENCIL_OP_INCREMENT_AND_WRAP;
+	case 0x8508: return VK_STENCIL_OP_DECREMENT_AND_WRAP;
+	default: return VK_STENCIL_OP_KEEP;
+	}
+}
+
+static int topo_class(int prim)
+{
+	if (prim == NV2A_PRIM_POINTS) return 0;
+	if (prim >= NV2A_PRIM_LINES && prim <= NV2A_PRIM_LINE_STRIP) return 1;
+	return 2;
+}
+
+static VkPrimitiveTopology topo_of(int prim)
+{
+	switch (prim) {
+	case NV2A_PRIM_POINTS: return VK_PRIMITIVE_TOPOLOGY_POINT_LIST;
+	case NV2A_PRIM_LINES: return VK_PRIMITIVE_TOPOLOGY_LINE_LIST;
+	case NV2A_PRIM_LINE_LOOP:
+	case NV2A_PRIM_LINE_STRIP: return VK_PRIMITIVE_TOPOLOGY_LINE_STRIP;
+	case NV2A_PRIM_TRIANGLE_STRIP: return VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP;
+	case NV2A_PRIM_TRIANGLE_FAN: return VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN;
+	default: return VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+	}
+}
+
+static uint64_t key_hash(const PipeKey *k)
+{
+	const uint8_t *b = (const uint8_t *)k;
+	uint64_t h = 1469598103934665603ull;
+	for (size_t i = 0; i < sizeof *k; i++)
+		h = (h ^ b[i]) * 1099511628211ull;
+	return h;
+}
+
+static VkPipeline make_pipeline(const PipeKey *k)
+{
+	VkProg *p = &g_prog[k->prog - 1];
+	double t0 = now_ms();
+	VkPipelineShaderStageCreateInfo stages[2] = {
+		{.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_VERTEX_BIT,
+		 .module = p->vs, .pName = "main"},
+		{.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+		 .module = p->fs, .pName = "main"},
+	};
+	VkVertexInputBindingDescription binds[2];
+	VkVertexInputAttributeDescription attrs[16];
+	uint32_t nb = 0, na = 0, from_array = 0;
+	for (int i = 0; i < 16; i++) {
+		if (!(p->inputs & (1u << i)))
+			continue;
+		if (k->at[i] >= 0) {
+			attrs[na++] = (VkVertexInputAttributeDescription){(uint32_t)i, 0, VK_FORMAT_R32G32B32A32_SFLOAT,
+			                                                  (uint32_t)k->at[i] * 4};
+			from_array = 1;
+		} else {
+			attrs[na++] = (VkVertexInputAttributeDescription){(uint32_t)i, 1, VK_FORMAT_R32G32B32A32_SFLOAT,
+			                                                  (uint32_t)i * 16};
+		}
+	}
+	if (from_array)
+		binds[nb++] = (VkVertexInputBindingDescription){0, k->stride * 4, VK_VERTEX_INPUT_RATE_VERTEX};
+	binds[nb++] = (VkVertexInputBindingDescription){1, 0, VK_VERTEX_INPUT_RATE_VERTEX};
+	VkPipelineVertexInputStateCreateInfo vi = {.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO,
+	                                           .vertexBindingDescriptionCount = nb,
+	                                           .pVertexBindingDescriptions = binds,
+	                                           .vertexAttributeDescriptionCount = na,
+	                                           .pVertexAttributeDescriptions = attrs};
+	static const VkPrimitiveTopology class_topo[3] = {VK_PRIMITIVE_TOPOLOGY_POINT_LIST,
+	                                                  VK_PRIMITIVE_TOPOLOGY_LINE_LIST,
+	                                                  VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST};
+	VkPipelineInputAssemblyStateCreateInfo ia = {.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+	                                             .topology = class_topo[(k->flags >> 30) & 3]};
+	VkPipelineViewportStateCreateInfo vp = {.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+	                                        .viewportCount = 1, .scissorCount = 1};
+	VkPipelineRasterizationStateCreateInfo rs = {
+		.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+		.depthClampEnable = (k->flags >> 29) & 1, .polygonMode = VK_POLYGON_MODE_FILL, .lineWidth = 1.0f};
+	VkPipelineMultisampleStateCreateInfo ms = {.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+	                                           .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT};
+	VkPipelineDepthStencilStateCreateInfo ds = {.sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+	uint32_t cm = (k->flags >> 24) & 0xF;
+	VkPipelineColorBlendAttachmentState ba = {
+		.blendEnable = (k->flags >> 28) & 1,
+		.srcColorBlendFactor = blend_of((k->flags >> 12) & 0xFFF), .dstColorBlendFactor = blend_of(k->flags & 0xFFF),
+		.colorBlendOp = VK_BLEND_OP_ADD,
+		.srcAlphaBlendFactor = blend_of((k->flags >> 12) & 0xFFF), .dstAlphaBlendFactor = blend_of(k->flags & 0xFFF),
+		.alphaBlendOp = VK_BLEND_OP_ADD, .colorWriteMask = cm};
+	VkPipelineColorBlendStateCreateInfo cb = {.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+	                                          .attachmentCount = 1, .pAttachments = &ba};
+	static const VkDynamicState dyn[] = {
+		VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR, VK_DYNAMIC_STATE_CULL_MODE, VK_DYNAMIC_STATE_FRONT_FACE,
+		VK_DYNAMIC_STATE_PRIMITIVE_TOPOLOGY, VK_DYNAMIC_STATE_DEPTH_TEST_ENABLE, VK_DYNAMIC_STATE_DEPTH_WRITE_ENABLE,
+		VK_DYNAMIC_STATE_DEPTH_COMPARE_OP, VK_DYNAMIC_STATE_STENCIL_TEST_ENABLE, VK_DYNAMIC_STATE_STENCIL_OP,
+		VK_DYNAMIC_STATE_STENCIL_COMPARE_MASK, VK_DYNAMIC_STATE_STENCIL_WRITE_MASK,
+		VK_DYNAMIC_STATE_STENCIL_REFERENCE, VK_DYNAMIC_STATE_DEPTH_BIAS, VK_DYNAMIC_STATE_DEPTH_BIAS_ENABLE};
+	VkPipelineDynamicStateCreateInfo dy = {.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO,
+	                                       .dynamicStateCount = sizeof dyn / sizeof dyn[0], .pDynamicStates = dyn};
+	VkPipelineRenderingCreateInfo rinfo = {.sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+	                                       .colorAttachmentCount = 1, .pColorAttachmentFormats = &COLOR_FMT,
+	                                       .depthAttachmentFormat = g_depth_fmt,
+	                                       .stencilAttachmentFormat = g_depth_fmt};
+	VkGraphicsPipelineCreateInfo gi = {.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, .pNext = &rinfo,
+	                                   .stageCount = 2, .pStages = stages, .pVertexInputState = &vi,
+	                                   .pInputAssemblyState = &ia, .pViewportState = &vp, .pRasterizationState = &rs,
+	                                   .pMultisampleState = &ms, .pDepthStencilState = &ds, .pColorBlendState = &cb,
+	                                   .pDynamicState = &dy, .layout = g_pipe_layout};
+	VkPipeline pipe = VK_NULL_HANDLE;
+	VkResult r = vkCreateGraphicsPipelines(g_dev, g_pipe_cache, 1, &gi, NULL, &pipe);
+	if (r != VK_SUCCESS)
+		LOG("pipeline for program %u refused (%d)\n", k->prog, r);
+	n_pipes++;
+	ms_pipes += now_ms() - t0;
+	return pipe;
+}
+
+static VkPipeline pipeline_for(int prim)
+{
+	VkProg *p = &g_prog[g_cur_prog - 1];
+	PipeKey k;
+	memset(&k, 0, sizeof k);
+	k.prog = g_cur_prog;
+	uint32_t cm = g_rs.color_mask ? g_rs.color_mask : 0x01010101u, mask = 0;
+	if ((cm >> 16) & 1) mask |= VK_COLOR_COMPONENT_R_BIT;
+	if ((cm >> 8) & 1) mask |= VK_COLOR_COMPONENT_G_BIT;
+	if (cm & 1) mask |= VK_COLOR_COMPONENT_B_BIT;
+	if ((cm >> 24) & 1) mask |= VK_COLOR_COMPONENT_A_BIT;
+	int clamp = ((g_rs.zclamp & 0xF0u) || g_rs.w_buffer) ? 1 : 0;
+	k.flags = (uint32_t)topo_class(prim) << 30 | (uint32_t)clamp << 29 | mask << 24;
+	if (g_rs.blend_enable)
+		k.flags |= 1u << 28 | ((uint32_t)g_rs.blend_src & 0xFFF) << 12 | ((uint32_t)g_rs.blend_dst & 0xFFF);
+	int any_array = 0;
+	for (int i = 0; i < 16; i++) {
+		k.at[i] = (p->inputs & (1u << i)) ? g_vb_at[i] : -1;
+		if (k.at[i] >= 0)
+			any_array = 1;
+	}
+	k.stride = any_array ? g_vb_stride : 0;
+	uint64_t h = key_hash(&k);
+	uint32_t free_at = UINT32_MAX;
+	for (uint32_t i = 0; i < PIPE_SLOTS; i++) {
+		PipeSlot *s = &g_pipes[(h + i) & (PIPE_SLOTS - 1)];
+		if (s->used == 1 && !memcmp(&s->key, &k, sizeof k))
+			return s->pipe;
+		if (s->used != 1 && free_at == UINT32_MAX)
+			free_at = (uint32_t)((h + i) & (PIPE_SLOTS - 1));
+		if (!s->used)
+			break;
+	}
+	VkPipeline pipe = make_pipeline(&k);
+	if (pipe && free_at != UINT32_MAX) {
+		g_pipes[free_at].key = k;
+		g_pipes[free_at].pipe = pipe;
+		g_pipes[free_at].used = 1;
+	}
+	return pipe;
+}
+
+
+/*
+ * The surface trace (V3, decision log D40): JSRF_VK_SURFTRACE=1. The graffiti and the boost haze are drawn into
+ * small surfaces (not 4:3, e.g. 512x512) that the frame then samples, and come out wrong here only. For each such
+ * surface this logs what is done to it -- an "episode" from being bound to being left: its clears, its draws and
+ * their state -- and what it holds: three rows of pixels copied out on the GPU when it is left and when it is first
+ * sampled after that, read on the CPU once that frame's fence has passed, so nothing about the drawing changes.
+ * The first sampled pictures of each go to /app0/vkdump as BMP files. Repeats of an episode are counted, not logged.
+ */
+#define TR_PROBES 48
+#define TR_DUMPS 8
+static int g_tr = -1;
+static unsigned tr_lines;
+static struct {
+	int open;              /* an episode is going on */
+	uint32_t clears, draws, nprog, prog[4];
+	uint32_t states[6], nstates, samples_tex;
+	char clear_txt[160];
+	uint64_t sig;
+	int sampled_since;     /* sampled since the episode ended */
+	float clear_rgba[4];
+	uint32_t episodes;
+} g_trs[MAX_RT];
+static struct { uint64_t sig; uint32_t n; } g_tr_seen[256];
+static struct {
+	VkBuffer buf;
+	VkDeviceMemory mem;
+	uint8_t *map;
+	uint32_t used, n;
+	struct { uint32_t rt, w, at; int kind; uint64_t sig; } p[TR_PROBES];
+} g_trp[FRAMES];
+static struct {
+	VkBuffer buf;
+	VkDeviceMemory mem;
+	uint8_t *map;
+	uint32_t cap;
+	int pending, slot;
+	uint32_t rt, w, h, n;
+} g_trd;
+
+static int tr_env = -1;
+
+/* Tracing now: the TRACE mode or JSRF_VK_SURFTRACE, and the probe buffers made. */
+static int tr_live(void)
+{
+	return g_tr > 0 && ((jsrf_vk_modes & JSRF_VK_TRACE) || tr_env > 0);
+}
+
+static int tr_on(void)
+{
+	if (tr_env < 0) {
+		const char *v = getenv("JSRF_VK_SURFTRACE");
+		tr_env = v && *v && *v != '0';
+	}
+	if (!(jsrf_vk_modes & JSRF_VK_TRACE) && tr_env <= 0)
+		return 0;
+	if (g_tr < 0) {
+		g_tr = 1;
+		{
+			for (int i = 0; i < FRAMES; i++)
+				if (!host_buffer(4u << 20, VK_BUFFER_USAGE_TRANSFER_DST_BIT, &g_trp[i].buf, &g_trp[i].mem,
+				                 &g_trp[i].map))
+					g_tr = 0;
+			mkdir("/app0/vkdump", 0777);
+			LOG("surface trace on\n");
+		}
+	}
+	return g_tr;
+}
+
+static int tr_traced(uint32_t h)
+{
+	return rt_ok(h) && (uint64_t)g_rt[h - 1].pw * 3 != (uint64_t)g_rt[h - 1].ph * 4;
+}
+
+static int tr_say(void)
+{
+	return tr_lines++ < 6000;
+}
+
+static uint64_t tr_mix(uint64_t h, uint64_t v)
+{
+	return (h ^ v) * 1099511628211ull;
+}
+
+/* Three rows of `h` copied into this frame's probe buffer, in the command stream where it stands. */
+static void tr_probe(uint32_t h, int kind, uint64_t sig)
+{
+	Frame *f = &g_fr[g_slot];
+	(void)f;
+	VkRT *rt = &g_rt[h - 1];
+	uint32_t row = rt->pw * 4, need = row * 3;
+	if (g_trp[g_slot].n >= TR_PROBES || g_trp[g_slot].used + need > (4u << 20))
+		return;
+	uint32_t at = g_trp[g_slot].used;
+	uint32_t keep = g_cur_rt;
+	pass_end();
+	VkCommandBuffer c = cmd();
+	barrier_all(c);
+	VkBufferImageCopy r[3];
+	for (int i = 0; i < 3; i++)
+		r[i] = (VkBufferImageCopy){.bufferOffset = at + (uint32_t)i * row,
+		                           .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+		                           .imageOffset = {0, (int32_t)(rt->ph * (uint32_t)(i + 1) / 4), 0},
+		                           .imageExtent = {rt->pw, 1, 1}};
+	vkCmdCopyImageToBuffer(c, g_tex[rt->color - 1].image, VK_IMAGE_LAYOUT_GENERAL, g_trp[g_slot].buf, 3, r);
+	barrier_all(c);
+	g_cur_rt = keep;
+	g_trp[g_slot].p[g_trp[g_slot].n++] = (typeof(g_trp[0].p[0])){h, rt->pw, at, kind, sig};
+	g_trp[g_slot].used += need;
+}
+
+/* The whole of `h` copied out once, for a BMP. */
+static void tr_dump(uint32_t h)
+{
+	VkRT *rt = &g_rt[h - 1];
+	uint64_t bytes = (uint64_t)rt->pw * rt->ph * 4;
+	if (g_trd.pending || g_trd.n >= TR_DUMPS || bytes > (64u << 20))
+		return;
+	if (bytes > g_trd.cap) {
+		if (g_trd.buf) {
+			vkDeviceWaitIdle(g_dev);
+			vkDestroyBuffer(g_dev, g_trd.buf, NULL);
+			vkFreeMemory(g_dev, g_trd.mem, NULL);
+			g_trd.buf = VK_NULL_HANDLE;
+		}
+		if (!host_buffer(bytes, VK_BUFFER_USAGE_TRANSFER_DST_BIT, &g_trd.buf, &g_trd.mem, &g_trd.map))
+			return;
+		g_trd.cap = (uint32_t)bytes;
+	}
+	uint32_t keep = g_cur_rt;
+	pass_end();
+	VkCommandBuffer c = cmd();
+	barrier_all(c);
+	VkBufferImageCopy r = {.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .imageExtent = {rt->pw, rt->ph, 1}};
+	vkCmdCopyImageToBuffer(c, g_tex[rt->color - 1].image, VK_IMAGE_LAYOUT_GENERAL, g_trd.buf, 1, &r);
+	barrier_all(c);
+	g_cur_rt = keep;
+	g_trd.pending = 1;
+	g_trd.slot = g_slot;
+	g_trd.rt = h;
+	g_trd.w = rt->pw;
+	g_trd.h = rt->ph;
+}
+
+static void tr_write_bmp(void)
+{
+	char name[512];
+	uint32_t step = (g_trd.w + 511) / 512, w = g_trd.w / step, h = g_trd.h / step;
+	snprintf(name, sizeof name, "/app0/vkdump/%02u_rt%u_%ux%u.bmp", g_trd.n, g_trd.rt, g_trd.w, g_trd.h);
+	FILE *fp = fopen(name, "wb");
+	g_trd.n++;
+	if (!fp)
+		return;
+	uint32_t rowb = (w * 3 + 3) & ~3u, size = 54 + rowb * h;
+	uint8_t hd[54] = {'B', 'M'};
+	memcpy(hd + 2, &size, 4);
+	uint32_t v = 54; memcpy(hd + 10, &v, 4);
+	v = 40; memcpy(hd + 14, &v, 4);
+	memcpy(hd + 18, &w, 4);
+	memcpy(hd + 22, &h, 4);
+	uint16_t planes = 1, bits = 24; memcpy(hd + 26, &planes, 2); memcpy(hd + 28, &bits, 2);
+	fwrite(hd, 1, 54, fp);
+	uint8_t *line = calloc(1, rowb);
+	for (uint32_t y = 0; y < h && line; y++) {
+		const uint8_t *src = g_trd.map + (size_t)((h - 1 - y) * step) * g_trd.w * 4; /* BMP rows bottom-up */
+		for (uint32_t x = 0; x < w; x++) {
+			const uint8_t *px = src + (size_t)x * step * 4;
+			line[x * 3 + 0] = px[2];
+			line[x * 3 + 1] = px[1];
+			line[x * 3 + 2] = px[0];
+		}
+		fwrite(line, 1, rowb, fp);
+	}
+	free(line);
+	fclose(fp);
+	LOG("trace: wrote %s\n", name);
+}
+
+static void trace_frame_done(int slot)
+{
+	if (g_tr <= 0)
+		return;
+	for (uint32_t i = 0; i < g_trp[slot].n; i++) {
+		typeof(g_trp[0].p[0]) *q = &g_trp[slot].p[i];
+		const uint8_t *px = g_trp[slot].map + q->at;
+		uint32_t n = q->w * 3, lit = 0, a0 = 0;
+		double sr = 0, sg = 0, sb = 0, sa = 0;
+		for (uint32_t k = 0; k < n; k++, px += 4) {
+			if (px[0] | px[1] | px[2]) lit++;
+			if (!px[3]) a0++;
+			sr += px[0]; sg += px[1]; sb += px[2]; sa += px[3];
+		}
+		if (tr_say())
+			LOG("trace: f%llu rt %u %s: %u%% not black, %u%% alpha 0, mean rgba %.0f %.0f %.0f %.0f (episode %016llx)\n",
+			    (unsigned long long)n_frames, q->rt, q->kind ? "when sampled" : "when left", lit * 100 / n, a0 * 100 / n, sr / n, sg / n, sb / n,
+			    sa / n, (unsigned long long)q->sig);
+	}
+	g_trp[slot].n = 0;
+	g_trp[slot].used = 0;
+	if (g_trd.pending && g_trd.slot == slot) {
+		tr_write_bmp();
+		g_trd.pending = 0;
+	}
+}
+
+static void trace_bind(uint32_t from, uint32_t to)
+{
+	if (!tr_on())
+		return;
+	if (tr_traced(from) && g_trs[from - 1].open) {
+		typeof(g_trs[0]) *t = &g_trs[from - 1];
+		t->open = 0;
+		t->sampled_since = 0;
+		uint64_t sig = tr_mix(tr_mix(tr_mix(14695981039346656037ull, from), t->clears), t->draws > 8 ? 9 : t->draws);
+		for (uint32_t i = 0; i < t->nstates; i++)
+			sig = tr_mix(sig, t->states[i]);
+		t->sig = sig;
+		uint32_t k = (uint32_t)(sig % 256);
+		if (g_tr_seen[k].sig != sig) {
+			g_tr_seen[k].sig = sig;
+			g_tr_seen[k].n = 0;
+		}
+		if (g_tr_seen[k].n++ < 3) {
+			if (tr_say()) {
+				LOG("trace: f%llu rt %u (%ux%u) episode %016llx, %s time: clears%s; %u draws, %u programs, states",
+				    (unsigned long long)n_frames, from,
+				    g_rt[from - 1].pw, g_rt[from - 1].ph, (unsigned long long)sig,
+				    g_tr_seen[k].n == 1 ? "first" : "again", t->clears ? t->clear_txt : " none", t->draws, t->nprog);
+				for (uint32_t i = 0; i < t->nstates; i++)
+					fprintf(stderr, " %08x", t->states[i]);
+				fprintf(stderr, "; samples a target %u times\n", t->samples_tex);
+			}
+			tr_probe(from, 0, sig);
+		}
+	}
+	if (tr_traced(to)) {
+		typeof(g_trs[0]) *t = &g_trs[to - 1];
+		uint32_t keep_sampled = t->sampled_since;
+		uint64_t keep_sig = t->sig;
+		float keep_clear[4];
+		memcpy(keep_clear, t->clear_rgba, sizeof keep_clear);
+		uint32_t ep = t->episodes + 1;
+		memset(t, 0, sizeof *t);
+		t->open = 1;
+		t->episodes = ep;
+		t->sampled_since = (int)keep_sampled;
+		t->sig = keep_sig;
+		memcpy(t->clear_rgba, keep_clear, sizeof keep_clear);
+	}
+}
+
+static void trace_clear(unsigned mask, const float rgba[4], const uint32_t rect[4])
+{
+	if (!tr_live() || !tr_traced(g_cur_rt) || !g_trs[g_cur_rt - 1].open)
+		return;
+	typeof(g_trs[0]) *t = &g_trs[g_cur_rt - 1];
+	size_t at = strlen(t->clear_txt);
+	if (t->clears < 3 && at < sizeof t->clear_txt - 60) {
+		if (rect)
+			snprintf(t->clear_txt + at, sizeof t->clear_txt - at, " [mask %u, %.2f %.2f %.2f %.2f, rect %u,%u-%u,%u]",
+			         mask, rgba[0], rgba[1], rgba[2], rgba[3], rect[0], rect[1], rect[2], rect[3]);
+		else
+			snprintf(t->clear_txt + at, sizeof t->clear_txt - at, " [mask %u, %.2f %.2f %.2f %.2f, all]", mask,
+			         rgba[0], rgba[1], rgba[2], rgba[3]);
+	}
+	if (mask & 1)
+		memcpy(t->clear_rgba, rgba, sizeof t->clear_rgba);
+	t->clears++;
+}
+
+static void trace_draw(int prim, uint32_t count)
+{
+	(void)count;
+	if (!tr_live())
+		return;
+	/* this draw's state, in one word: blend, its factors, the colour mask, depth, stencil, the topology */
+	if (tr_traced(g_cur_rt) && g_trs[g_cur_rt - 1].open) {
+		typeof(g_trs[0]) *t = &g_trs[g_cur_rt - 1];
+		uint32_t cm = g_rs.color_mask ? g_rs.color_mask : 0x01010101u;
+		uint32_t st = (uint32_t)(g_rs.blend_enable != 0) << 31 | ((uint32_t)g_rs.blend_src & 0xF) << 27 |
+		              ((uint32_t)g_rs.blend_dst & 0xF) << 23 | ((cm >> 24) & 1) << 22 | ((cm >> 16) & 1) << 21 |
+		              ((cm >> 8) & 1) << 20 | (cm & 1) << 19 | (uint32_t)(g_rs.depth_test != 0) << 18 |
+		              (uint32_t)(g_rs.depth_write != 0) << 17 | ((uint32_t)g_rs.depth_func & 0xF) << 13 |
+		              (uint32_t)(g_rs.stencil_test != 0) << 12 | (uint32_t)(g_rs.alpha_test != 0) << 11 |
+		              (uint32_t)(g_rs.cull_enable != 0) << 10 | ((uint32_t)prim & 0xF) << 6 |
+		              (prog_ok(g_cur_prog) ? g_prog[g_cur_prog - 1].samplers & 0xF : 0);
+		uint32_t i;
+		for (i = 0; i < t->nstates && t->states[i] != st; i++)
+			;
+		if (i == t->nstates && t->nstates < 6)
+			t->states[t->nstates++] = st;
+		for (i = 0; i < t->nprog && t->prog[i] != g_cur_prog; i++)
+			;
+		if (i == t->nprog && t->nprog < 4)
+			t->prog[t->nprog++] = g_cur_prog;
+		t->draws++;
+	}
+	/* a traced target sampled by this draw: the first time since it was last left */
+	if (!prog_ok(g_cur_prog))
+		return;
+	uint32_t smp = g_prog[g_cur_prog - 1].samplers;
+	for (int u = 0; u < 4; u++) {
+		if (!((smp >> u) & 1) || !tex_ok(g_bound[u]) || !g_tex[g_bound[u] - 1].is_target)
+			continue;
+		uint32_t r;
+		for (r = 1; r <= MAX_RT; r++)
+			if (g_rt[r - 1].used && g_rt[r - 1].color == g_bound[u])
+				break;
+		if (r > MAX_RT || !tr_traced(r))
+			continue;
+		if (tr_traced(g_cur_rt) && g_trs[g_cur_rt - 1].open)
+			g_trs[g_cur_rt - 1].samples_tex++;
+		typeof(g_trs[0]) *t = &g_trs[r - 1];
+		if (t->sampled_since || t->open)
+			continue;
+		t->sampled_since = 1;
+		uint32_t k = (uint32_t)(t->sig % 256);
+		if (g_tr_seen[k].sig == t->sig && g_tr_seen[k].n <= 3) {
+			if (tr_say())
+				LOG("trace: f%llu rt %u sampled on unit %u by a draw into rt %u (%ux%u), blend %d %x/%x, mask %08x\n",
+				    (unsigned long long)n_frames, r, u,
+				    g_cur_rt, g_rt[g_cur_rt - 1].pw, g_rt[g_cur_rt - 1].ph, g_rs.blend_enable, g_rs.blend_src,
+				    g_rs.blend_dst, g_rs.color_mask);
+			tr_probe(r, 1, t->sig);
+			tr_dump(r);
+		}
+	}
+}
+
+/*
+ * The frame capture (decision log D41, the CAPTURE FRAME mode): one frame, from the present after the mode is switched
+ * on to the next, written to /app0/vkcap: every draw into the log (made or dropped and why, its program, textures and
+ * their sampling, blend, masks, alpha test, depth, stencil, culling, scissor), each texture it samples as a small BMP,
+ * each program's Vulkan GLSL, and the frame as shown. Then the mode switches itself off. At most 3 captures a run.
+ */
+#define CAP_TEX 384
+#define CAP_BYTES (160u << 20)
+static struct {
+	int state;                 /* 0 off, 1 armed (from the next present), 2 capturing */
+	int n, slot, pending;
+	uint32_t draws;
+	VkBuffer buf;
+	VkDeviceMemory mem;
+	uint8_t *map;
+	uint32_t used;
+	struct { uint32_t tex, w, h, at; Nv2aSampler smp; } tex[CAP_TEX];
+	FILE *ev;                  /* the frame's events in order: bind, clear, draw, present (D43) */
+	uint32_t ntex;
+	uint32_t frame_w, frame_h, frame_at;
+	uint8_t prog_seen[MAX_PROG];
+} g_cap;
+
+static void cap_bmp(const char *name, const uint8_t *rgba, uint32_t w, uint32_t h, uint32_t maxw)
+{
+	uint32_t step = (w + maxw - 1) / maxw, ow = w / step, oh = h / step;
+	if (!ow || !oh)
+		return;
+	FILE *fp = fopen(name, "wb");
+	if (!fp)
+		return;
+	uint32_t rowb = (ow * 3 + 3) & ~3u, size = 54 + rowb * oh, v;
+	uint8_t hd[54] = {'B', 'M'};
+	memcpy(hd + 2, &size, 4);
+	v = 54; memcpy(hd + 10, &v, 4);
+	v = 40; memcpy(hd + 14, &v, 4);
+	memcpy(hd + 18, &ow, 4);
+	memcpy(hd + 22, &oh, 4);
+	uint16_t planes = 1, bits = 24; memcpy(hd + 26, &planes, 2); memcpy(hd + 28, &bits, 2);
+	fwrite(hd, 1, 54, fp);
+	uint8_t *line = calloc(1, rowb);
+	for (uint32_t y = 0; y < oh && line; y++) {
+		const uint8_t *src = rgba + (size_t)((oh - 1 - y) * step) * w * 4;
+		for (uint32_t x = 0; x < ow; x++) {
+			const uint8_t *px = src + (size_t)x * step * 4;
+			line[x * 3 + 0] = px[2];
+			line[x * 3 + 1] = px[1];
+			line[x * 3 + 2] = px[0];
+		}
+		fwrite(line, 1, rowb, fp);
+	}
+	free(line);
+	fclose(fp);
+}
+
+/* Level 0 of a texture into the capture buffer, in the command stream. */
+static int cap_copy_tex(uint32_t hnd)
+{
+	VkTex *t = &g_tex[hnd - 1];
+	uint32_t bytes = t->w * t->h * 4;
+	if (g_cap.ntex >= CAP_TEX || g_cap.used + bytes > CAP_BYTES)
+		return 0;
+	uint32_t keep = g_cur_rt;
+	pass_end();
+	VkCommandBuffer c = cmd();
+	barrier_all(c);
+	VkImageLayout l = t->is_target ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+	if (!t->is_target)
+		image_layout(c, t->image, VK_IMAGE_ASPECT_COLOR_BIT, t->levels, l, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+	VkBufferImageCopy r = {.bufferOffset = g_cap.used, .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+	                       .imageExtent = {t->w, t->h, 1}};
+	vkCmdCopyImageToBuffer(c, t->image, t->is_target ? l : VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, g_cap.buf, 1, &r);
+	if (!t->is_target)
+		image_layout(c, t->image, VK_IMAGE_ASPECT_COLOR_BIT, t->levels, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, l);
+	barrier_all(c);
+	g_cur_rt = keep;
+	g_cap.tex[g_cap.ntex++] = (typeof(g_cap.tex[0])){hnd, t->w, t->h, g_cap.used, t->smp};
+	g_cap.used += bytes;
+	return 1;
+}
+
+static void capture_draw(int prim, uint32_t count)
+{
+	if (g_cap.state != 2)
+		return;
+	uint32_t d = g_cap.draws++;
+	if (d >= 3000)
+		return;
+	char texs[256] = "";
+	size_t at = 0;
+	uint32_t smp = prog_ok(g_cur_prog) ? g_prog[g_cur_prog - 1].samplers : 0;
+	for (int u = 0; u < 4; u++) {
+		if (!((smp >> u) & 1))
+			continue;
+		uint32_t h = g_bound[u];
+		if (!tex_ok(h)) {
+			at += (size_t)snprintf(texs + at, sizeof texs - at, " u%d:none", u);
+			continue;
+		}
+		VkTex *t = &g_tex[h - 1];
+		uint32_t i;
+		for (i = 0; i < g_cap.ntex && g_cap.tex[i].tex != h; i++)
+			;
+		if (i == g_cap.ntex)
+			cap_copy_tex(h);
+		at += (size_t)snprintf(texs + at, sizeof texs - at, " u%d:t%u%s %ux%u l%u mag%u min%u mip%u wrap%u%u", u, h,
+		                       t->is_target ? "(target)" : "", t->w, t->h, t->levels, t->smp.mag_linear,
+		                       t->smp.min_linear, t->smp.mip, t->smp.wrap_s, t->smp.wrap_t);
+		if (at >= sizeof texs)
+			at = sizeof texs - 1;
+	}
+	int af = -1;
+	float aref = 0;
+	if (prog_ok(g_cur_prog)) {
+		VkProg *p = &g_prog[g_cur_prog - 1];
+		int32_t o = p->off[1][NV2A_U_ALPHAFUNC], o2 = p->off[1][NV2A_U_ALPHAREF];
+		if (o >= 0) memcpy(&af, p->fu + o, 4);
+		if (o2 >= 0) memcpy(&aref, p->fu + o2, 4);
+		if (!g_cap.prog_seen[g_cur_prog - 1] && p->src_v && p->src_f) {
+			char name[512];
+			g_cap.prog_seen[g_cur_prog - 1] = 1;
+			snprintf(name, sizeof name, CAP_DIR "/c%d_p%u.vert", g_cap.n, g_cur_prog);
+			FILE *fp = fopen(name, "w");
+			if (fp) { fputs(p->src_v, fp); fclose(fp); }
+			snprintf(name, sizeof name, CAP_DIR "/c%d_p%u.frag", g_cap.n, g_cur_prog);
+			fp = fopen(name, "w");
+			if (fp) { fputs(p->src_f, fp); fclose(fp); }
+		}
+	}
+	/* The draw's inputs, for working its shaders through off the console: the program's blocks as they were copied
+	 * for this draw, the constant attributes, the layout and the first 16 vertices. */
+	if (prog_ok(g_cur_prog) && d < 400) {
+		char name[512];
+		snprintf(name, sizeof name, CAP_DIR "/c%d_d%u.bin", g_cap.n, d);
+		FILE *fp = fopen(name, "wb");
+		if (fp) {
+			VkProg *p = &g_prog[g_cur_prog - 1];
+			uint32_t nv = count < 8192 ? count : 8192, hd[24] = {0x32504143u /* CAP2 */, g_cur_prog, p->vu_size, p->fu_size,
+			                                                  g_vb_stride, nv};
+			for (int i = 0; i < 16; i++)
+				hd[6 + i] = (uint32_t)(int32_t)g_vb_at[i];
+			hd[22] = (uint32_t)prim;
+			hd[23] = count;
+			fwrite(hd, 4, 24, fp);
+			uint32_t rsz = sizeof g_rs, bound[4];
+			fwrite(&rsz, 4, 1, fp);
+			fwrite(&g_rs, 1, sizeof g_rs, fp);
+			for (int u = 0; u < 4; u++)
+				bound[u] = ((smp >> u) & 1) ? g_bound[u] : 0;
+			fwrite(bound, 4, 4, fp);
+			fwrite(p->vu, 1, p->vu_size, fp);
+			fwrite(p->fu, 1, p->fu_size, fp);
+			fwrite(g_generic, 1, sizeof g_generic, fp);
+			if (g_vb_stride && nv)
+				fwrite(g_fr[g_slot].ring_map + g_vb_off, 4, (size_t)g_vb_stride * nv, fp);
+			fclose(fp);
+		}
+	}
+	if (g_cap.ev)
+		fprintf(g_cap.ev, "draw %u %d %u\n", d, prim, count);
+	fprintf(stderr, "  [CAP] d%u %s rt%u p%u prim%d n%u |%s | blend %d %x/%x cm %08x atest %d %.3f | z %d/%d f%x | "
+	                "st %d f%x ref%u ops %x/%x/%x | cull %d %x %x | sc %d %u,%u-%u,%u\n",
+	        d, g_drop ? g_drop : "drawn", g_cur_rt, g_cur_prog, prim, count, texs, g_rs.blend_enable, g_rs.blend_src,
+	        g_rs.blend_dst, g_rs.color_mask, af, aref, g_rs.depth_test, g_rs.depth_write, g_rs.depth_func,
+	        g_rs.stencil_test, g_rs.stencil_func, g_rs.stencil_ref, g_rs.stencil_op[0], g_rs.stencil_op[1],
+	        g_rs.stencil_op[2], g_rs.cull_enable, g_rs.cull_face, g_rs.front_face, g_rs.scissor_enable,
+	        g_rs.scissor[0], g_rs.scissor[1], g_rs.scissor[2], g_rs.scissor[3]);
+}
+
+static void capture_bind(uint32_t rt)
+{
+	if (g_cap.state == 2 && g_cap.ev && rt_ok(rt))
+		fprintf(g_cap.ev, "bind %u %u %u %u\n", rt, g_rt[rt - 1].pw, g_rt[rt - 1].ph, g_rt[rt - 1].color);
+}
+
+static void capture_clear(unsigned mask, const float rgba[4], float depth, uint32_t stencil, const uint32_t rect[4])
+{
+	if (g_cap.state != 2 || !g_cap.ev)
+		return;
+	fprintf(g_cap.ev, "clear %u %.9g %.9g %.9g %.9g %.9g %u", mask, rgba[0], rgba[1], rgba[2], rgba[3], depth, stencil);
+	if (rect)
+		fprintf(g_cap.ev, " %u %u %u %u\n", rect[0], rect[1], rect[2], rect[3]);
+	else
+		fprintf(g_cap.ev, "\n");
+}
+
+/* At each present: arm, start, or finish (the shown target copied out) a capture. */
+static void capture_present(uint32_t rt)
+{
+	if (g_cap.state == 0 && (jsrf_vk_modes & JSRF_VK_CAPTURE)) {
+		if (g_cap.n >= 3 || g_cap.pending) {
+			jsrf_vk_modes &= ~(uint32_t)JSRF_VK_CAPTURE;
+			return;
+		}
+		if (!g_cap.buf && !host_buffer(CAP_BYTES, VK_BUFFER_USAGE_TRANSFER_DST_BIT, &g_cap.buf, &g_cap.mem, &g_cap.map)) {
+			LOG("capture: no buffer\n");
+			jsrf_vk_modes &= ~(uint32_t)JSRF_VK_CAPTURE;
+			return;
+		}
+		mkdir(CAP_DIR, 0777);
+		g_cap.state = 2;
+		g_cap.draws = g_cap.ntex = g_cap.used = 0;
+		memset(g_cap.prog_seen, 0, sizeof g_cap.prog_seen);
+		LOG("capture %d: from frame %llu\n", g_cap.n, (unsigned long long)n_frames + 1);
+		char ename[512];
+		snprintf(ename, sizeof ename, CAP_DIR "/c%d_events.txt", g_cap.n);
+		g_cap.ev = fopen(ename, "w");
+		if (g_cap.ev) {
+			fprintf(g_cap.ev, "zrev %d\n", g_zrev);
+			if (rt_ok(g_cur_rt))
+				fprintf(g_cap.ev, "bind %u %u %u %u\n", g_cur_rt, g_rt[g_cur_rt - 1].pw, g_rt[g_cur_rt - 1].ph,
+				        g_rt[g_cur_rt - 1].color);
+		}
+		return;
+	}
+	if (g_cap.state != 2)
+		return;
+	if (rt_ok(rt)) {
+		VkRT *r = &g_rt[rt - 1];
+		uint32_t bytes = r->pw * r->ph * 4;
+		if (g_cap.used + bytes <= CAP_BYTES) {
+			pass_end();
+			VkCommandBuffer c = cmd();
+			barrier_all(c);
+			VkBufferImageCopy cr = {.bufferOffset = g_cap.used,
+			                        .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+			                        .imageExtent = {r->pw, r->ph, 1}};
+			vkCmdCopyImageToBuffer(c, g_tex[r->color - 1].image, VK_IMAGE_LAYOUT_GENERAL, g_cap.buf, 1, &cr);
+			barrier_all(c);
+			g_cap.frame_w = r->pw;
+			g_cap.frame_h = r->ph;
+			g_cap.frame_at = g_cap.used;
+			g_cap.used += bytes;
+		}
+	}
+	if (g_cap.ev) {
+		fprintf(g_cap.ev, "present %u\n", rt);
+		fclose(g_cap.ev);
+		g_cap.ev = NULL;
+	}
+	LOG("capture %d: %u draws (%llu dropped so far in the run), %u textures\n", g_cap.n, g_cap.draws,
+	    (unsigned long long)n_dropped, g_cap.ntex);
+	g_cap.state = 0;
+	g_cap.pending = 1;
+	g_cap.slot = g_slot;
+	jsrf_vk_modes &= ~(uint32_t)JSRF_VK_CAPTURE;
+}
+
+static void capture_frame_done(int slot)
+{
+	if (!g_cap.pending || g_cap.slot != slot)
+		return;
+	char name[512];
+	for (uint32_t i = 0; i < g_cap.ntex; i++) {
+		snprintf(name, sizeof name, CAP_DIR "/c%d_t%u.bmp", g_cap.n, g_cap.tex[i].tex);
+		cap_bmp(name, g_cap.map + g_cap.tex[i].at, g_cap.tex[i].w, g_cap.tex[i].h, 128);
+		/* and whole, for the frame replay: width, height, the sampler, the texels */
+		snprintf(name, sizeof name, CAP_DIR "/c%d_t%u.raw", g_cap.n, g_cap.tex[i].tex);
+		FILE *fp = fopen(name, "wb");
+		if (fp) {
+			fwrite(&g_cap.tex[i].w, 4, 1, fp);
+			fwrite(&g_cap.tex[i].h, 4, 1, fp);
+			fwrite(&g_cap.tex[i].smp, 1, sizeof(Nv2aSampler), fp);
+			fwrite(g_cap.map + g_cap.tex[i].at, 4, (size_t)g_cap.tex[i].w * g_cap.tex[i].h, fp);
+			fclose(fp);
+		}
+	}
+	if (g_cap.frame_w) {
+		snprintf(name, sizeof name, CAP_DIR "/c%d_frame.bmp", g_cap.n);
+		cap_bmp(name, g_cap.map + g_cap.frame_at, g_cap.frame_w, g_cap.frame_h, 960);
+	}
+	LOG("capture %d written to /app0/vkcap\n", g_cap.n);
+	g_cap.frame_w = 0;
+	g_cap.pending = 0;
+	g_cap.n++;
+}
+
+/* Where a frame's time goes (V3), in TSC ticks: the front half's method handling (nv2a_pb_exec.c), the part of it in
+ * this backend's draws and vertices, and present's waits (the swapchain image and the frame slot's fence). */
+uint64_t jsrf_tsc_front;
+static uint64_t tsc_backend, tsc_wait;
+#define TSC_NOW() __builtin_ia32_rdtsc()
+
+/* Draws that sample a unit and get black in its place (V3): the handle given is gone, or none was given. */
+static uint64_t n_tex_gone, n_tex_none;
+
+static VkDescriptorSet descriptor_set(void)
+{
+	Frame *f = &g_fr[g_slot];
+	uint32_t tex[4];
+	const uint32_t sampled = prog_ok(g_cur_prog) ? g_prog[g_cur_prog - 1].samplers : 0;
+	/* RESOLVE: a target about to be sampled, moved out of GENERAL and back, so RADV resolves what a fast clear or
+	 * compression left in its metadata; the round trip leaves it in GENERAL, where everything else expects it. */
+	if (jsrf_vk_modes & JSRF_VK_RESOLVE) {
+		for (int u = 0; u < 4; u++) {
+			if (!((sampled >> u) & 1) || !tex_ok(g_bound[u]) || !g_tex[g_bound[u] - 1].is_target)
+				continue;
+			for (uint32_t r = 0; r < MAX_RT; r++) {
+				VkRT *t = &g_rt[r];
+				if (!t->used || t->color != g_bound[u] || !t->dirty || r + 1 == g_cur_rt)
+					continue;
+				pass_end();
+				VkCommandBuffer c = cmd();
+				image_layout(c, g_tex[t->color - 1].image, VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_GENERAL,
+				             VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+				image_layout(c, g_tex[t->color - 1].image, VK_IMAGE_ASPECT_COLOR_BIT, 1,
+				             VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL);
+				t->dirty = 0;
+				n_resolves++;
+				g_set = VK_NULL_HANDLE;
+				break;
+			}
+		}
+	}
+	for (int u = 0; u < 4; u++) {
+		tex[u] = tex_ok(g_bound[u]) ? g_bound[u] : g_black;
+		if ((sampled >> u) & 1) {
+			if (g_bound[u] && !tex_ok(g_bound[u])) {
+				if (n_tex_gone++ < 8)
+					LOG("unit %d samples texture %u, which is gone: black instead\n", u, g_bound[u]);
+			} else if (!g_bound[u]) {
+				if (n_tex_none++ < 8)
+					LOG("unit %d is sampled with no texture bound: black instead\n", u);
+			}
+		}
+	}
+	if (g_set && g_set_stamp == g_stamp && !memcmp(tex, g_set_tex, sizeof tex))
+		return g_set;
+	VkDescriptorSet set = VK_NULL_HANDLE;
+	for (;;) {
+		if (f->pool_at == f->npools) {
+			if (f->npools == 16)
+				return VK_NULL_HANDLE;
+			VkDescriptorPoolSize sizes[2] = {{VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, 2 * 4096},
+			                                 {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 4 * 4096}};
+			VkDescriptorPoolCreateInfo pi = {.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+			                                 .maxSets = 4096, .poolSizeCount = 2, .pPoolSizes = sizes};
+			if (vkCreateDescriptorPool(g_dev, &pi, NULL, &f->pools[f->npools]) != VK_SUCCESS)
+				return VK_NULL_HANDLE;
+			f->npools++;
+		}
+		VkDescriptorSetAllocateInfo ai = {.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+		                                  .descriptorPool = f->pools[f->pool_at], .descriptorSetCount = 1,
+		                                  .pSetLayouts = &g_set_layout};
+		if (vkAllocateDescriptorSets(g_dev, &ai, &set) == VK_SUCCESS)
+			break;
+		f->pool_at++;
+	}
+	VkDescriptorBufferInfo bufs[2] = {{f->ring, 0, UBO_RANGE}, {f->ring, 0, UBO_RANGE}};
+	VkDescriptorImageInfo imgs[4];
+	for (int u = 0; u < 4; u++) {
+		VkTex *t = &g_tex[tex[u] - 1];
+		imgs[u] = (VkDescriptorImageInfo){t->sampler, t->view,
+		                                  t->is_target ? VK_IMAGE_LAYOUT_GENERAL
+		                                               : VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+	}
+	VkWriteDescriptorSet w[3] = {
+		{.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set, .dstBinding = 0, .descriptorCount = 1,
+		 .descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, .pBufferInfo = &bufs[0]},
+		{.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set, .dstBinding = 1, .descriptorCount = 1,
+		 .descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, .pBufferInfo = &bufs[1]},
+		{.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set, .dstBinding = 2, .descriptorCount = 4,
+		 .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .pImageInfo = imgs},
+	};
+	vkUpdateDescriptorSets(g_dev, 3, w, 0, NULL);
+	g_set = set;
+	g_set_stamp = g_stamp;
+	memcpy(g_set_tex, tex, sizeof tex);
+	return set;
+}
+
+/* The program's blocks as this draw sees them, in the ring. */
+static int uniforms_ready(VkProg *p, uint32_t *ov, uint32_t *of)
+{
+	void *dst;
+	if (p->dirty_v || p->ring_stamp_v != g_stamp) {
+		uint32_t at = ring_alloc(p->vu_size ? p->vu_size : 16, &dst);
+		if (at == UINT32_MAX) return 0;
+		memcpy(dst, p->vu, p->vu_size ? p->vu_size : 16);
+		p->ring_v = at;
+		p->ring_stamp_v = g_stamp;
+		p->dirty_v = 0;
+	}
+	if (p->dirty_f || p->ring_stamp_f != g_stamp) {
+		uint32_t at = ring_alloc(p->fu_size ? p->fu_size : 16, &dst);
+		if (at == UINT32_MAX) return 0;
+		memcpy(dst, p->fu, p->fu_size ? p->fu_size : 16);
+		p->ring_f = at;
+		p->ring_stamp_f = g_stamp;
+		p->dirty_f = 0;
+	}
+	*ov = p->ring_v;
+	*of = p->ring_f;
+	return 1;
+}
+
+static void vk_draw_body(int prim, uint32_t count);
+static void vk_draw(int prim, uint32_t count)
+{
+	uint64_t t0 = TSC_NOW();
+	g_drop = NULL;
+	vk_draw_body(prim, count);
+	if (g_drop)
+		n_dropped++;
+	capture_draw(prim, count);
+	tsc_backend += TSC_NOW() - t0;
+}
+
+static void vk_draw_body(int prim, uint32_t count)
+{
+	static int nocull = -1;
+	if (nocull < 0) {
+		const char *v = getenv("RECOMP_GL_NOCULL");
+		nocull = v && *v && *v != '0';
+	}
+	if (!count || !rt_ok(g_cur_rt) || !prog_ok(g_cur_prog) || !g_have_verts)
+		{ g_drop = !count ? "no vertices" : !rt_ok(g_cur_rt) ? "no target" : !prog_ok(g_cur_prog) ? "no program"
+		                                                                                    : "vertices not given"; return; }
+	nocull = (nocull & 1) | ((jsrf_vk_modes & JSRF_VK_NOCULL) ? 2 : 0);
+	if (prim >= NV2A_PRIM_TRIANGLES && g_rs.cull_enable && g_rs.cull_face == 0x408 && !nocull)
+		{ g_drop = "both faces culled"; return; } /* front and back culled */
+	if (prim == NV2A_PRIM_TRIANGLE_FAN && count < 3)
+		{ g_drop = "if (prim == NV2A_PRIM_TRIANGLE_FAN && count < 3)"; return; }
+	VkProg *p = &g_prog[g_cur_prog - 1];
+	uint32_t ov, of;
+	/* the ring first: a full one submits the work so far, and the pass with it */
+	if (!uniforms_ready(p, &ov, &of))
+		{ g_drop = "if (!uniforms_ready(p, &ov, &of))"; return; }
+	uint32_t loop_at = 0;
+	if (prim == NV2A_PRIM_LINE_LOOP) {
+		uint32_t *ix;
+		loop_at = ring_alloc((count + 1) * 4, (void **)&ix);
+		if (loop_at == UINT32_MAX) { g_drop = "if (loop_at == UINT32_MAX) return;"; return; }
+		for (uint32_t i = 0; i < count; i++) ix[i] = i;
+		ix[count] = 0;
+	}
+	if (!g_have_verts || !uniforms_ready(p, &ov, &of)) /* again, in case the ring started over */
+		{ g_drop = "if (!g_have_verts || !uniforms_ready(p, &ov, &of)) /* again,"; return; }
+	VkDescriptorSet set = descriptor_set();
+	if (!set)
+		{ g_drop = "if (!set)"; return; }
+	VkPipeline pipe = pipeline_for(prim);
+	if (!pipe)
+		{ g_drop = "if (!pipe)"; return; }
+	if (!pass_begin())
+		{ g_drop = "if (!pass_begin())"; return; }
+	VkCommandBuffer c = cmd();
+	VkRT *rt = &g_rt[g_cur_rt - 1];
+	if (!E.valid || E.pipe != pipe) {
+		vkCmdBindPipeline(c, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe);
+		E.pipe = pipe;
+	}
+	int cull = (!nocull && g_rs.cull_enable) ? (g_rs.cull_face == 0x404 ? 1 : 2) : 0;
+	if (!E.valid || E.cull != cull) {
+		vkCmdSetCullMode(c, cull == 1 ? VK_CULL_MODE_FRONT_BIT : cull == 2 ? VK_CULL_MODE_BACK_BIT : VK_CULL_MODE_NONE);
+		E.cull = cull;
+	}
+	int wind = g_rs.front_face == 0x901;
+	if (!E.valid || E.wind != wind) {
+		vkCmdSetFrontFace(c, wind ? VK_FRONT_FACE_COUNTER_CLOCKWISE : VK_FRONT_FACE_CLOCKWISE);
+		E.wind = wind;
+	}
+	int topo = (int)topo_of(prim);
+	if (!E.valid || E.topo != topo) {
+		vkCmdSetPrimitiveTopology(c, (VkPrimitiveTopology)topo);
+		E.topo = topo;
+	}
+	int dt = g_rs.depth_test != 0, dw = dt && g_rs.depth_write, df = (int)cmp_of((uint32_t)g_rs.depth_func);
+	/* Test modes (D43): a blended draw with a depth test -- a decal over a wall -- nudged toward the camera, or
+	 * drawn with no depth test at all. Toward the camera is a larger depth with reversed depth, a smaller one
+	 * without. */
+	int bias = dt && g_rs.blend_enable && (jsrf_vk_modes & JSRF_VK_DECALBIAS);
+	if (dt && g_rs.blend_enable && (jsrf_vk_modes & JSRF_VK_BLENDNOZ))
+		dt = dw = 0;
+	if (!E.valid || E.bias != bias) {
+		vkCmdSetDepthBiasEnable(c, (VkBool32)bias);
+		if (bias)
+			vkCmdSetDepthBias(c, g_zrev ? 16.0f : -16.0f, 0.0f, g_zrev ? 1.0f : -1.0f);
+		E.bias = bias;
+	}
+	if (!E.valid || E.dt != dt) { vkCmdSetDepthTestEnable(c, (VkBool32)dt); E.dt = dt; }
+	if (!E.valid || E.dw != dw) { vkCmdSetDepthWriteEnable(c, (VkBool32)dw); E.dw = dw; }
+	if (!E.valid || E.df != df) { vkCmdSetDepthCompareOp(c, (VkCompareOp)df); E.df = df; }
+	int st = g_rs.stencil_test != 0;
+	if (!E.valid || E.st != st) { vkCmdSetStencilTestEnable(c, (VkBool32)st); E.st = st; }
+	uint32_t sf = g_rs.stencil_func >= 0x200 && g_rs.stencil_func <= 0x207 ? g_rs.stencil_func : 0x207;
+	uint32_t sops = (uint32_t)sop_of(g_rs.stencil_op[0]) | (uint32_t)sop_of(g_rs.stencil_op[1]) << 4 |
+	                (uint32_t)sop_of(g_rs.stencil_op[2]) << 8;
+	if (!E.valid || E.sfunc != sf || E.sops != sops) {
+		vkCmdSetStencilOp(c, VK_STENCIL_FACE_FRONT_AND_BACK, sop_of(g_rs.stencil_op[0]), sop_of(g_rs.stencil_op[2]),
+		                  sop_of(g_rs.stencil_op[1]), cmp_of(sf));
+		E.sfunc = sf;
+		E.sops = sops;
+	}
+	if (!E.valid || E.rmask != (g_rs.stencil_rmask & 0xFF)) {
+		vkCmdSetStencilCompareMask(c, VK_STENCIL_FACE_FRONT_AND_BACK, g_rs.stencil_rmask & 0xFF);
+		E.rmask = g_rs.stencil_rmask & 0xFF;
+	}
+	if (!E.valid || E.wmask != (g_rs.stencil_wmask & 0xFF)) {
+		vkCmdSetStencilWriteMask(c, VK_STENCIL_FACE_FRONT_AND_BACK, g_rs.stencil_wmask & 0xFF);
+		E.wmask = g_rs.stencil_wmask & 0xFF;
+	}
+	if (!E.valid || E.ref != (g_rs.stencil_ref & 0xFF)) {
+		vkCmdSetStencilReference(c, VK_STENCIL_FACE_FRONT_AND_BACK, g_rs.stencil_ref & 0xFF);
+		E.ref = g_rs.stencil_ref & 0xFF;
+	}
+	VkRect2D sc = {{0, 0}, {rt->pw, rt->ph}};
+	if (g_rs.scissor_enable) {
+		uint32_t x0 = g_rs.scissor[0], y0 = g_rs.scissor[1], x1 = g_rs.scissor[2], y1 = g_rs.scissor[3];
+		if (x1 > rt->pw) x1 = rt->pw;
+		if (y1 > rt->ph) y1 = rt->ph;
+		if (x0 > x1) x0 = x1;
+		if (y0 > y1) y0 = y1;
+		sc = (VkRect2D){{(int32_t)x0, (int32_t)y0}, {x1 - x0, y1 - y0}};
+	}
+	if (!sc.extent.width || !sc.extent.height)
+		{ g_drop = "empty scissor"; return; }
+	if (!E.valid || memcmp(&E.sc, &sc, sizeof sc)) {
+		vkCmdSetScissor(c, 0, 1, &sc);
+		E.sc = sc;
+	}
+	E.valid = 1;
+	uint32_t dyn[2] = {ov, of};
+	vkCmdBindDescriptorSets(c, VK_PIPELINE_BIND_POINT_GRAPHICS, g_pipe_layout, 0, 1, &set, 2, dyn);
+	VkBuffer bufs[2] = {g_vb_buf ? g_vb_buf : g_fr[g_slot].ring, g_fr[g_slot].ring};
+	VkDeviceSize offs[2] = {g_vb_off, g_cb_off};
+	vkCmdBindVertexBuffers(c, 0, 2, bufs, offs);
+	if (g_draw_idx) {
+		vkCmdBindIndexBuffer(c, g_ib_buf, g_ib_off, g_draw_idx == 2 ? VK_INDEX_TYPE_UINT32 : VK_INDEX_TYPE_UINT16);
+		vkCmdDrawIndexed(c, count, 1, 0, 0, 0);
+	} else if (prim == NV2A_PRIM_LINE_LOOP) {
+		vkCmdBindIndexBuffer(c, g_fr[g_slot].ring, loop_at, VK_INDEX_TYPE_UINT32);
+		vkCmdDrawIndexed(c, count + 1, 1, 0, 0, 0);
+	} else {
+		vkCmdDraw(c, count, 1, 0, 0);
+	}
+	n_draws++;
+	trace_draw(prim, count);
+}
+
+
+/*
+ * Geometry kept between draws (decision log D54): the front half's vertex cache (nv2a_gl.c) decides what is kept and
+ * whether it still matches the title's memory; this holds the buffers, as the OpenGL device does. A kept buffer is
+ * host-visible memory of its own; refilled while a frame in flight may still read it (bound this frame or the one
+ * before), it gets new memory and the old is freed when that frame slot comes round. The stream buffer, refilled for
+ * nearly every draw, lives in the frame's ring like vertices() does. Without these the front half converted every
+ * draw's vertices again (vtx_convert, a tenth of the render thread in busy scenes).
+ */
+#define MAX_VB 16384
+typedef struct {
+	uint8_t used, stream;
+	VkBuffer buf;
+	VkDeviceMemory mem;
+	uint8_t *map;
+	uint32_t cap, vbytes, ibytes, ioff;
+	uint64_t bound_frame;          /* n_frames when last bound */
+	uint32_t ring_v, ring_i;       /* the stream buffer: its data in the ring ... */
+	uint64_t ring_stamp;           /* ... as of this submission */
+} VkVb;
+static VkVb *g_vbs;
+static uint64_t n_vb_fills, n_vb_orphans, n_vb_lost;
+
+static uint32_t vk_vbuf_new(int stream)
+{
+	if (!g_vbs && !(g_vbs = calloc(MAX_VB, sizeof *g_vbs)))
+		return 0;
+	for (uint32_t i = 0; i < MAX_VB; i++)
+		if (!g_vbs[i].used) {
+			memset(&g_vbs[i], 0, sizeof g_vbs[i]);
+			g_vbs[i].used = 1;
+			g_vbs[i].stream = stream != 0;
+			return i + 1;
+		}
+	LOG("out of kept vertex buffers\n");
+	return 0;
+}
+
+static VkVb *vb_of(uint32_t h)
+{
+	return (g_vbs && h && h <= MAX_VB && g_vbs[h - 1].used) ? &g_vbs[h - 1] : NULL;
+}
+
+static void vb_release(VkVb *b)
+{
+	if (b->buf) {
+		defer(DEAD_BUF, (uint64_t)b->buf);
+		defer(DEAD_MEM, (uint64_t)b->mem);
+	}
+	b->buf = VK_NULL_HANDLE;
+	b->mem = VK_NULL_HANDLE;
+	b->map = NULL;
+	b->cap = 0;
+}
+
+static void vk_vbuf_free(uint32_t h)
+{
+	VkVb *b = vb_of(h);
+	if (!b)
+		return;
+	vb_release(b);
+	b->used = 0;
+}
+
+static void vk_vbuf_fill(uint32_t h, const float *v, uint32_t vbytes, const void *idx, uint32_t ibytes)
+{
+	VkVb *b = vb_of(h);
+	if (!b)
+		return;
+	n_vb_fills++;
+	if (b->stream) {
+		void *p;
+		if (v) {
+			uint32_t at = ring_alloc(vbytes ? vbytes : 4, &p);
+			if (at == UINT32_MAX) return;
+			memcpy(p, v, vbytes);
+			b->ring_v = at;
+			b->vbytes = vbytes;
+		}
+		if (idx) {
+			uint32_t at = ring_alloc(ibytes ? ibytes : 4, &p);
+			if (at == UINT32_MAX) return;
+			memcpy(p, idx, ibytes);
+			b->ring_i = at;
+			b->ibytes = ibytes;
+		}
+		b->ring_stamp = g_stamp;
+		return;
+	}
+	/* what the buffer holds after this fill: new vertices and/or new indices, the rest kept */
+	uint32_t nv = v ? vbytes : b->vbytes, ni = idx ? ibytes : b->ibytes;
+	uint32_t ioff = (nv + 15) & ~15u, need = ioff + ni;
+	if (need == 0)
+		need = 16;
+	int busy = b->buf && b->bound_frame + 1 >= n_frames;
+	if (!b->buf || need > b->cap || busy) {
+		/* new memory: keep what is not being replaced */
+		uint8_t *old = b->map;
+		uint32_t old_v = b->vbytes, old_ioff = b->ioff, old_i = b->ibytes;
+		VkBuffer nb;
+		VkDeviceMemory nm;
+		uint8_t *nmap;
+		uint32_t cap = need < 4096 ? 4096 : (need + need / 4 + 255) & ~255u;
+		if (!host_buffer(cap, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT, &nb, &nm, &nmap)) {
+			LOG("no memory for a kept vertex buffer of %u bytes\n", cap);
+			return;
+		}
+		if (old) {
+			if (!v && old_v) memcpy(nmap, old, old_v);
+			if (!idx && old_i) memcpy(nmap + ioff, old + old_ioff, old_i);
+		}
+		if (busy) n_vb_orphans++;
+		vb_release(b);
+		b->buf = nb;
+		b->mem = nm;
+		b->map = nmap;
+		b->cap = cap;
+	} else if (!idx && b->ibytes && ioff != b->ioff) {
+		memmove(b->map + ioff, b->map + b->ioff, b->ibytes);   /* the vertices grew or shrank under kept indices */
+	}
+	if (v) memcpy(b->map, v, vbytes);
+	if (idx) memcpy(b->map + ioff, idx, ibytes);
+	b->vbytes = nv;
+	b->ibytes = ni;
+	b->ioff = ioff;
+}
+
+static void vk_vbuf_bind(uint32_t h, uint32_t stride_floats, const int attr_at[16], uint32_t const_mask,
+                         const float const_attr[16][4])
+{
+	uint64_t t0 = __builtin_ia32_rdtsc();
+	VkVb *b = vb_of(h);
+	g_have_verts = 0;
+	g_vb_buf = VK_NULL_HANDLE;
+	if (!b) return;
+	if (b->stream) {
+		if (b->ring_stamp != g_stamp) {   /* the ring started over since the fill: its data may be gone */
+			n_vb_lost++;
+			return;
+		}
+		g_vb_off = b->ring_v;
+		g_ib_buf = g_fr[g_slot].ring;
+		g_ib_off = b->ring_i;
+	} else {
+		if (!b->buf) return;
+		g_vb_buf = b->buf;
+		g_vb_off = 0;
+		g_ib_buf = b->buf;
+		g_ib_off = b->ioff;
+		b->bound_frame = n_frames;
+	}
+	g_vb_stride = stride_floats;
+	for (int i = 0; i < 16; i++) {
+		g_vb_at[i] = (int16_t)(b->vbytes ? attr_at[i] : -1);
+		if (attr_at[i] < 0 && (const_mask & (1u << i)))
+			memcpy(g_generic[i], const_attr[i], 16);
+	}
+	void *p;
+	uint32_t at = ring_alloc(sizeof g_generic, &p);
+	if (at == UINT32_MAX) return;
+	memcpy(p, g_generic, sizeof g_generic);
+	g_cb_off = at;
+	if (b->stream && b->ring_stamp != g_stamp) {   /* that ring_alloc started the ring over */
+		n_vb_lost++;
+		return;
+	}
+	g_have_verts = 1;
+	tsc_backend_v += __builtin_ia32_rdtsc() - t0;
+}
+
+static void vk_draw_indexed(int prim, uint32_t count, int idx32)
+{
+	g_draw_idx = idx32 ? 2 : 1;
+	vk_draw(prim, count);
+	g_draw_idx = 0;
+}
+
+/* ---- clears and the flip -------------------------------------------------------------------------------------- */
+
+static void vk_clear(unsigned mask, const float rgba[4], float depth, uint32_t stencil, const uint32_t rect[4])
+{
+	if (!rt_ok(g_cur_rt) || !(mask & 7) || !pass_begin())
+		return;
+	VkRT *rt = &g_rt[g_cur_rt - 1];
+	VkClearAttachment at[2];
+	uint32_t n = 0;
+	if (mask & 1)
+		at[n++] = (VkClearAttachment){VK_IMAGE_ASPECT_COLOR_BIT, 0,
+		                              {.color = {{rgba[0], rgba[1], rgba[2], rgba[3]}}}};
+	if (mask & 6) {
+		VkImageAspectFlags a = ((mask & 2) ? VK_IMAGE_ASPECT_DEPTH_BIT : 0) |
+		                       ((mask & 4) ? VK_IMAGE_ASPECT_STENCIL_BIT : 0);
+		at[n++] = (VkClearAttachment){a, 0, {.depthStencil = {depth, stencil & 0xFF}}};
+	}
+	uint32_t x0 = 0, y0 = 0, x1 = rt->pw, y1 = rt->ph;
+	if (rect) {
+		x0 = rect[0]; y0 = rect[1]; x1 = rect[2]; y1 = rect[3];
+		if (x1 > rt->pw) x1 = rt->pw;
+		if (y1 > rt->ph) y1 = rt->ph;
+		if (x0 >= x1 || y0 >= y1)
+			return;
+	}
+	VkClearRect cr = {{{(int32_t)x0, (int32_t)y0}, {x1 - x0, y1 - y0}}, 0, 1};
+	vkCmdClearAttachments(cmd(), n, at, 1, &cr);
+	trace_clear(mask, rgba, rect);
+	capture_clear(mask, rgba, depth, stencil, rect);
+}
+
+/* jsrf-ps5: the test modes' indicator (D41), a small picture made on the CPU, drawn over the top-left corner of every
+ * frame at twice its size; NULL takes it away. */
+void nv2a_vk_overlay(const void *rgba, uint32_t w, uint32_t h)
+{
+	if (g_ovl)
+		vk_tex_free(g_ovl);
+	g_ovl = 0;
+	if (!rgba || !w || !h)
+		return;
+	Nv2aSampler s = {0};
+	g_ovl = vk_tex_new(w, h, rgba, &s);
+	g_ovl_w = w;
+	g_ovl_h = h;
+}
+
+static void vk_present(uint32_t h, uint32_t pw, uint32_t ph)
+{
+	if (jsrf_ps5_frame_hook)
+		jsrf_ps5_frame_hook();
+	capture_present(h);
+	Frame *f = &g_fr[g_slot];
+	uint32_t img = 0;
+	pass_end();
+	uint64_t tw = TSC_NOW();
+	VkResult r = vkAcquireNextImageKHR(g_dev, g_swap, UINT64_MAX, f->acquired, VK_NULL_HANDLE, &img);
+	tsc_wait += TSC_NOW() - tw;
+	if (r != VK_SUCCESS && r != VK_SUBOPTIMAL_KHR) {
+		LOG("acquire failed (%d)\n", r);
+		submit(VK_NULL_HANDLE, VK_NULL_HANDLE, 1);
+		return;
+	}
+	VkCommandBuffer c = cmd();
+	barrier_all(c);
+	image_layout(c, g_swap_img[img], VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_UNDEFINED,
+	             VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+	VkClearColorValue black = {{0, 0, 0, 1}};
+	VkImageSubresourceRange range = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+	vkCmdClearColorImage(c, g_swap_img[img], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &black, 1, &range);
+	if (rt_ok(h)) {
+		VkRT *rt = &g_rt[h - 1];
+		if (pw > rt->pw) pw = rt->pw;
+		if (ph > rt->ph) ph = rt->ph;
+		/* the frame letterboxed in 4:3, or the wider scene's own aspect (as nv2a_gl.c's sdl_present) */
+		int fw = 1200, fh = 900;
+		if (nv2a_wide_scene()) {
+			fw = (int)(nv2a_wide_aspect() * 900.0f + 0.5f);
+			fh = 900;
+		}
+		int dw = SWAP_W, dh = SWAP_H;
+		if ((long)SWAP_W * fh > (long)SWAP_H * fw) dw = (int)((long)SWAP_H * fw / fh);
+		else dh = (int)((long)SWAP_W * fh / fw);
+		int dx = (SWAP_W - dw) / 2, dy = (SWAP_H - dh) / 2;
+		barrier_all(c);
+		VkImageBlit b = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+		                 .srcOffsets = {{0, 0, 0}, {(int32_t)pw, (int32_t)ph, 1}},
+		                 .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+		                 .dstOffsets = {{dx, dy, 0}, {dx + dw, dy + dh, 1}}};
+		vkCmdBlitImage(c, g_tex[rt->color - 1].image, VK_IMAGE_LAYOUT_GENERAL, g_swap_img[img],
+		               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &b, VK_FILTER_LINEAR);
+	}
+	if (tex_ok(g_ovl)) {
+		VkImage oi = g_tex[g_ovl - 1].image;
+		barrier_all(c);
+		image_layout(c, oi, VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+		             VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+		VkImageBlit ob = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+		                  .srcOffsets = {{0, 0, 0}, {(int32_t)g_ovl_w, (int32_t)g_ovl_h, 1}},
+		                  .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+		                  .dstOffsets = {{48, 48, 0}, {48 + 2 * (int32_t)g_ovl_w, 48 + 2 * (int32_t)g_ovl_h, 1}}};
+		vkCmdBlitImage(c, oi, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, g_swap_img[img], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+		               1, &ob, VK_FILTER_NEAREST);
+		image_layout(c, oi, VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+		             VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	}
+	image_layout(c, g_swap_img[img], VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+	             VK_IMAGE_LAYOUT_PRESENT_SRC_KHR);
+	submit(f->acquired, g_rendered[img], 0);
+	VkPresentInfoKHR pi = {.sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR, .waitSemaphoreCount = 1,
+	                       .pWaitSemaphores = &g_rendered[img], .swapchainCount = 1, .pSwapchains = &g_swap,
+	                       .pImageIndices = &img};
+	r = vkQueuePresentKHR(g_queue, &pi);
+	if (r != VK_SUCCESS && r != VK_SUBOPTIMAL_KHR) {
+		static int said;
+		if (said++ < 4)
+			LOG("present failed (%d)\n", r);
+	}
+	n_frames++;
+	g_slot = (g_slot + 1) % FRAMES;
+	tw = TSC_NOW();
+	frame_start(); /* waits for this slot's last frame */
+	tsc_wait += TSC_NOW() - tw;
+}
+
+static void vk_report(void)
+{
+	LOG("%llu frames, %llu draws, %llu passes; %llu programs (%.0f ms; %llu from the cache's SPIR-V), %llu pipelines "
+	    "(%.0f ms); %llu textures (%.1f MB); %llu snapshots, %llu reads, %llu waits\n",
+	    (unsigned long long)n_frames, (unsigned long long)n_draws, (unsigned long long)n_passes,
+	    (unsigned long long)n_progs, ms_progs, (unsigned long long)n_progs_cached, (unsigned long long)n_pipes,
+	    ms_pipes, (unsigned long long)n_tex,
+	    tex_bytes / 1048576.0, (unsigned long long)n_snaps, (unsigned long long)n_reads,
+	    (unsigned long long)n_flushes);
+	{
+		/* the TSC's rate from the clock, between two reports */
+		static uint64_t last_tsc, last_frames, last_front, last_backend, last_v, last_wait;
+		static double last_ms;
+		const uint64_t tsc = TSC_NOW();
+		const double ms = now_ms();
+		if (last_ms > 0.0 && n_frames > last_frames) {
+			const double per_ms = (double)(tsc - last_tsc) / (ms - last_ms), fr = (double)(n_frames - last_frames);
+			LOG("ms a frame: %.1f in all; in this backend %.1f in draws, %.1f in vertices; present waits %.1f\n",
+			    (ms - last_ms) / fr, (double)(tsc_backend - last_backend) / per_ms / fr,
+			    (double)(tsc_backend_v - last_v) / per_ms / fr, (double)(tsc_wait - last_wait) / per_ms / fr);
+		}
+		last_tsc = tsc;
+		last_ms = ms;
+		last_frames = n_frames;
+		last_front = jsrf_tsc_front;
+		last_backend = tsc_backend;
+		last_v = tsc_backend_v;
+		last_wait = tsc_wait;
+	}
+	LOG("modes %x: %llu targets resolved before sampling; %llu draws dropped\n", jsrf_vk_modes,
+	    (unsigned long long)n_resolves, (unsigned long long)n_dropped);
+	LOG("kept vertex buffers: %llu fills, %llu given new memory while in use, %llu binds lost to the ring\n",
+	    (unsigned long long)n_vb_fills, (unsigned long long)n_vb_orphans, (unsigned long long)n_vb_lost);
+	if (n_tex_gone || n_tex_none)
+		LOG("black in place of a texture: %llu draws whose texture was gone, %llu with none bound\n",
+		    (unsigned long long)n_tex_gone, (unsigned long long)n_tex_none);
+}
+
+static double vk_pipeline_ms(void) { return ms_pipes; }
+
+/* ---- bringing it up ------------------------------------------------------------------------------------------- */
+
+void ps5_log_memory(void) __attribute__((weak)); /* jsrf-ps5: the direct memory left, which RADV allocates from */
+
+static int create_device(void)
+{
+	if (ps5_log_memory)
+		ps5_log_memory();
+	vkCreateInstance = (PFN_vkCreateInstance)vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, "vkCreateInstance");
+	const char *const exts[] = {VK_KHR_SURFACE_EXTENSION_NAME, VK_KHR_DISPLAY_EXTENSION_NAME};
+	VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO, .pApplicationName = "jsrf",
+	                         .apiVersion = VK_API_VERSION_1_3};
+	VkInstanceCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo = &app,
+#if defined(NV2A_VK_HOST)
+	                           .enabledExtensionCount = 0, .ppEnabledExtensionNames = exts};
+#else
+	                           .enabledExtensionCount = 2, .ppEnabledExtensionNames = exts};
+#endif
+	VkResult ir = vkCreateInstance ? vkCreateInstance(&ii, NULL, &g_instance) : VK_ERROR_INITIALIZATION_FAILED;
+	LOG("instance: result %d\n", ir);
+	if (ir != VK_SUCCESS) {
+		LOG("no instance\n");
+		return 0;
+	}
+#define LOAD_I(name) vk##name = (PFN_vk##name)vk_icdGetInstanceProcAddr(g_instance, "vk" #name);
+	INSTANCE_COMMANDS(LOAD_I)
+	uint32_t count = 1;
+	VkResult er = vkEnumeratePhysicalDevices(g_instance, &count, &g_phys);
+	LOG("physical devices: result %d, count %u, first %p\n", er, count, (void *)g_phys);
+	if ((er != VK_SUCCESS && er != VK_INCOMPLETE) || count < 1 || g_phys == VK_NULL_HANDLE) {
+		LOG("no GPU\n");
+		return 0;
+	}
+	VkPhysicalDeviceDriverProperties driver = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES};
+	VkPhysicalDeviceProperties2 props = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &driver};
+	vkGetPhysicalDeviceProperties2(g_phys, &props);
+	g_limits = props.properties.limits;
+	LOG("%s, %s %s\n", props.properties.deviceName, driver.driverName, driver.driverInfo);
+	VkQueueFamilyProperties families[8];
+	count = 8;
+	vkGetPhysicalDeviceQueueFamilyProperties(g_phys, &count, families);
+	for (uint32_t i = 0; i < count; i++)
+		if (families[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) {
+			g_family = i;
+			break;
+		}
+	vkGetPhysicalDeviceMemoryProperties(g_phys, &g_memprops);
+	VkFormatProperties fp;
+	vkGetPhysicalDeviceFormatProperties(g_phys, VK_FORMAT_D32_SFLOAT_S8_UINT, &fp);
+	if (!(fp.optimalTilingFeatures & VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT))
+		g_depth_fmt = VK_FORMAT_D24_UNORM_S8_UINT;
+	VkPhysicalDeviceFeatures have;
+	vkGetPhysicalDeviceFeatures(g_phys, &have);
+	VkPhysicalDeviceFeatures want = {.depthClamp = have.depthClamp, .samplerAnisotropy = have.samplerAnisotropy};
+	const float prio = 1.0f;
+	VkDeviceQueueCreateInfo qi = {.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO, .queueFamilyIndex = g_family,
+	                              .queueCount = 1, .pQueuePriorities = &prio};
+	VkPhysicalDeviceVulkan13Features f13 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+	                                        .synchronization2 = VK_TRUE, .dynamicRendering = VK_TRUE};
+	const char *const dexts[] = {VK_KHR_SWAPCHAIN_EXTENSION_NAME};
+	VkDeviceCreateInfo di = {.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, .pNext = &f13, .queueCreateInfoCount = 1,
+#if defined(NV2A_VK_HOST)
+	                         .pQueueCreateInfos = &qi, .enabledExtensionCount = 0, .ppEnabledExtensionNames = dexts,
+#else
+	                         .pQueueCreateInfos = &qi, .enabledExtensionCount = 1, .ppEnabledExtensionNames = dexts,
+#endif
+	                         .pEnabledFeatures = &want};
+	VkResult r = vkCreateDevice(g_phys, &di, NULL, &g_dev);
+	if (r != VK_SUCCESS) {
+		LOG("no device (%d)\n", r);
+		return 0;
+	}
+#define LOAD_D(name) vk##name = (PFN_vk##name)vkGetDeviceProcAddr(g_dev, "vk" #name);
+	DEVICE_COMMANDS(LOAD_D)
+	vkGetDeviceQueue(g_dev, g_family, 0, &g_queue);
+	LOG("depth %s, depth clamp %s\n", g_depth_fmt == VK_FORMAT_D32_SFLOAT_S8_UINT ? "D32S8" : "D24S8",
+	    have.depthClamp ? "yes" : "no");
+	return 1;
+}
+
+static int create_swapchain(void)
+{
+#if defined(NV2A_VK_HOST)
+	return 1; /* a replay on a computer shows nothing */
+#endif
+	VkDisplayPropertiesKHR display;
+	uint32_t count = 1;
+	if (vkGetPhysicalDeviceDisplayPropertiesKHR(g_phys, &count, &display) != VK_SUCCESS || count < 1) {
+		LOG("no display\n");
+		return 0;
+	}
+	VkDisplayModePropertiesKHR modes[4];
+	count = 4;
+	vkGetDisplayModePropertiesKHR(g_phys, display.display, &count, modes);
+	LOG("display %ux%u, %.3f Hz\n", display.physicalResolution.width, display.physicalResolution.height,
+	    modes[0].parameters.refreshRate / 1000.0);
+	VkDisplaySurfaceCreateInfoKHR si = {.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR,
+	                                    .displayMode = modes[0].displayMode,
+	                                    .transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR,
+	                                    .alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR,
+	                                    .imageExtent = {SWAP_W, SWAP_H}};
+	VkSurfaceKHR surface;
+	if (vkCreateDisplayPlaneSurfaceKHR(g_instance, &si, NULL, &surface) != VK_SUCCESS) {
+		LOG("no display surface\n");
+		return 0;
+	}
+	VkSurfaceCapabilitiesKHR caps;
+	vkGetPhysicalDeviceSurfaceCapabilitiesKHR(g_phys, surface, &caps);
+	VkImageUsageFlags usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+	if ((caps.supportedUsageFlags & usage) != usage)
+		LOG("the swapchain's usage 0x%x lacks transfer (0x%x)\n", caps.supportedUsageFlags, usage);
+	VkSwapchainCreateInfoKHR sc = {.sType = VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR, .surface = surface,
+	                               .minImageCount = 3, .imageFormat = VK_FORMAT_B8G8R8A8_UNORM,
+	                               .imageColorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR,
+	                               .imageExtent = {SWAP_W, SWAP_H}, .imageArrayLayers = 1, .imageUsage = usage,
+	                               .preTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR,
+	                               .compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR,
+	                               .presentMode = VK_PRESENT_MODE_FIFO_KHR, .clipped = VK_TRUE};
+	VkResult r = vkCreateSwapchainKHR(g_dev, &sc, NULL, &g_swap);
+	if (r != VK_SUCCESS) {
+		LOG("no swapchain (%d)\n", r);
+		return 0;
+	}
+	g_swap_n = 8;
+	vkGetSwapchainImagesKHR(g_dev, g_swap, &g_swap_n, g_swap_img);
+	VkSemaphoreCreateInfo sem = {.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+	for (uint32_t i = 0; i < g_swap_n; i++)
+		vkCreateSemaphore(g_dev, &sem, NULL, &g_rendered[i]);
+	return 1;
+}
+
+static int create_layouts(void)
+{
+	/* The texture units are four bindings of one sampler each, 2 to 5, as the shaders declare them (vulkanize). One
+	 * binding of four made units 1 to 3 bindings the layout did not have: RADV read some other descriptor there --
+	 * the graffiti pieces, the cel-shaded characters' second texture, the boost haze (decision log D44). The
+	 * descriptor write of four from binding 2 rolls over into 3, 4 and 5, which have the same type and stages. */
+	VkDescriptorSetLayoutBinding b[6] = {
+		{0, VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, 1, VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT,
+		 NULL},
+		{1, VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, 1, VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT,
+		 NULL},
+	};
+	for (uint32_t u = 0; u < 4; u++)
+		b[2 + u] = (VkDescriptorSetLayoutBinding){2 + u, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1,
+		                                          VK_SHADER_STAGE_FRAGMENT_BIT | VK_SHADER_STAGE_VERTEX_BIT, NULL};
+	VkDescriptorSetLayoutCreateInfo li = {.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+	                                      .bindingCount = 6, .pBindings = b};
+	if (vkCreateDescriptorSetLayout(g_dev, &li, NULL, &g_set_layout) != VK_SUCCESS)
+		return 0;
+	VkPipelineLayoutCreateInfo pl = {.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO, .setLayoutCount = 1,
+	                                 .pSetLayouts = &g_set_layout};
+	if (vkCreatePipelineLayout(g_dev, &pl, NULL, &g_pipe_layout) != VK_SUCCESS)
+		return 0;
+	VkPipelineCacheCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+	vkCreatePipelineCache(g_dev, &ci, NULL, &g_pipe_cache);
+	g_pipes = calloc(PIPE_SLOTS, sizeof *g_pipes);
+	return g_pipes != NULL;
+}
+
+static int create_frames(void)
+{
+	VkCommandPoolCreateInfo pi = {.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+	                              .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+	                              .queueFamilyIndex = g_family};
+	if (vkCreateCommandPool(g_dev, &pi, NULL, &g_pool) != VK_SUCCESS)
+		return 0;
+	for (int i = 0; i < FRAMES; i++) {
+		Frame *f = &g_fr[i];
+		VkCommandBuffer bufs[2];
+		VkCommandBufferAllocateInfo ai = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+		                                  .commandPool = g_pool, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+		                                  .commandBufferCount = 2};
+		if (vkAllocateCommandBuffers(g_dev, &ai, bufs) != VK_SUCCESS)
+			return 0;
+		f->cmd = bufs[0];
+		f->up = bufs[1];
+		VkFenceCreateInfo fi = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO, .flags = VK_FENCE_CREATE_SIGNALED_BIT};
+		VkSemaphoreCreateInfo si = {.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+		vkCreateFence(g_dev, &fi, NULL, &f->done);
+		vkCreateSemaphore(g_dev, &si, NULL, &f->acquired);
+		if (!host_buffer(RING_BYTES,
+		                 VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT |
+		                     VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+		                 &f->ring, &f->ring_mem, &f->ring_map)) {
+			LOG("no ring of %u MB\n", RING_BYTES >> 20);
+			return 0;
+		}
+	}
+	return 1;
+}
+
+static int vk_init(void)
+{
+	static int done = -1;
+	if (done >= 0)
+		return done;
+	done = 0;
+	double t0 = now_ms();
+	if (!create_device() || !create_swapchain() || !create_layouts() || !create_frames())
+		return 0;
+	if (!glslang_initialize_process()) {
+		LOG("glslang did not start\n");
+		return 0;
+	}
+	for (int i = 0; i < 16; i++) {
+		g_generic[i][0] = g_generic[i][1] = g_generic[i][2] = 0.0f;
+		g_generic[i][3] = 1.0f;
+	}
+	g_slot = 0;
+	frame_start();
+	static const uint8_t black[4] = {0, 0, 0, 255};
+	Nv2aSampler s = {0};
+	g_black = vk_tex_new(1, 1, black, &s);
+	LOG("up in %.0f ms: swapchain %ux%u, %u images\n", now_ms() - t0, SWAP_W, SWAP_H, g_swap_n);
+	done = g_black != 0;
+	return done;
+}
+
+/*
+ * jsrf-ps5: a picture made on the CPU (the start menu, decision log D37) shown before the engine runs. The display
+ * can be opened once, so the device and swapchain opened here are the ones the renderer gets later (vk_init runs
+ * once). `rgba` is w x h, scaled to the whole swapchain texel for texel (a whole multiple keeps the letters sharp).
+ */
+int nv2a_vk_show(const void *rgba, uint32_t w, uint32_t h)
+{
+	if (!vk_init())
+		return 0;
+	Nv2aSampler s = {0};
+	uint32_t t = vk_tex_new(w, h, rgba, &s);
+	if (!t)
+		return 0;
+	Frame *f = &g_fr[g_slot];
+	uint32_t img = 0;
+	VkResult r = vkAcquireNextImageKHR(g_dev, g_swap, UINT64_MAX, f->acquired, VK_NULL_HANDLE, &img);
+	if (r != VK_SUCCESS && r != VK_SUBOPTIMAL_KHR) {
+		LOG("acquire failed (%d)\n", r);
+		vk_tex_free(t);
+		submit(VK_NULL_HANDLE, VK_NULL_HANDLE, 1);
+		return 0;
+	}
+	VkCommandBuffer c = cmd();
+	barrier_all(c);
+	image_layout(c, g_swap_img[img], VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_UNDEFINED,
+	             VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+	image_layout(c, g_tex[t - 1].image, VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+	             VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+	VkImageBlit b = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+	                 .srcOffsets = {{0, 0, 0}, {(int32_t)w, (int32_t)h, 1}},
+	                 .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+	                 .dstOffsets = {{0, 0, 0}, {SWAP_W, SWAP_H, 1}}};
+	vkCmdBlitImage(c, g_tex[t - 1].image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, g_swap_img[img],
+	               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &b, VK_FILTER_NEAREST);
+	image_layout(c, g_swap_img[img], VK_IMAGE_ASPECT_COLOR_BIT, 1, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+	             VK_IMAGE_LAYOUT_PRESENT_SRC_KHR);
+	submit(f->acquired, g_rendered[img], 0);
+	VkPresentInfoKHR pi = {.sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR, .waitSemaphoreCount = 1,
+	                       .pWaitSemaphores = &g_rendered[img], .swapchainCount = 1, .pSwapchains = &g_swap,
+	                       .pImageIndices = &img};
+	r = vkQueuePresentKHR(g_queue, &pi);
+	vk_tex_free(t); /* on this frame's dead list: freed once the GPU has done the frame */
+	g_slot = (g_slot + 1) % FRAMES;
+	frame_start();
+	return r == VK_SUCCESS || r == VK_SUBOPTIMAL_KHR;
+}
+
+/* Reversed depth (nv2a_vsh.c, depth_defines), as Metal's: the clip volume already runs z from 0 to w, and with D32S8
+ * the depth is floating point, so only a new target's depth starts at 0, the far plane; the front half turns the
+ * comparisons and clears around. Not with the D24S8 fallback, whose fixed point gains nothing from it. */
+static int vk_zrev(int want)
+{
+	g_zrev = want && g_depth_fmt == VK_FORMAT_D32_SFLOAT_S8_UINT;
+	return g_zrev;
+}
+
+
+/*
+ * jsrf-ps5: replay of captured draws (decision log D43), before the game starts, with JSRF_VK_REPLAY set to a list
+ * such as /app0/vkcap/replay.txt. Each line: a draw's inputs (the capture's .bin), its Vulkan GLSL (vertex, fragment),
+ * a BMP per texture unit or "-", an output name, then the state to draw it with in variant B: blend, its factors,
+ * depth test, write and function, cull, cull face, front face. Each draw goes onto a fresh 1280x960 target twice --
+ * A with no depth, blend or culling, B with the state given -- through this backend's own pipelines, descriptors and
+ * draws, and comes back as <name>_A.bmp and <name>_B.bmp: RADV on the console against the same draw elsewhere.
+ */
+static uint8_t *replay_file(const char *name, size_t *len)
+{
+	FILE *fp = fopen(name, "rb");
+	if (!fp)
+		return NULL;
+	fseek(fp, 0, SEEK_END);
+	long n = ftell(fp);
+	fseek(fp, 0, SEEK_SET);
+	uint8_t *b = n > 0 ? malloc((size_t)n + 1) : NULL;
+	if (b && fread(b, 1, (size_t)n, fp) != (size_t)n) {
+		free(b);
+		b = NULL;
+	}
+	fclose(fp);
+	if (b) {
+		b[n] = 0;
+		*len = (size_t)n;
+	}
+	return b;
+}
+
+static uint32_t replay_tex(const char *name)
+{
+	size_t len;
+	uint8_t *b = replay_file(name, &len);
+	if (!b || len < 54)
+		return 0;
+	uint32_t w, h;
+	memcpy(&w, b + 18, 4);
+	memcpy(&h, b + 22, 4);
+	uint32_t rowb = (w * 3 + 3) & ~3u;
+	uint8_t *px = malloc((size_t)w * h * 4);
+	for (uint32_t y = 0; y < h && px && 54 + (size_t)(h - 1 - y) * rowb + w * 3 <= len; y++)
+		for (uint32_t x = 0; x < w; x++) {
+			const uint8_t *q = b + 54 + (size_t)(h - 1 - y) * rowb + x * 3;
+			uint8_t *o = px + ((size_t)y * w + x) * 4;
+			o[0] = q[2]; o[1] = q[1]; o[2] = q[0]; o[3] = 255;
+		}
+	Nv2aSampler s = {.min_linear = 1, .mag_linear = 1, .wrap_s = 1, .wrap_t = 1};
+	uint32_t t = px ? vk_tex_new(w, h, px, &s) : 0;
+	free(px);
+	free(b);
+	return t;
+}
+
+static void replay_bmp(const char *name, uint32_t rt, int alpha)
+{
+	VkRT *r = &g_rt[rt - 1];
+	uint8_t *px = malloc((size_t)r->pw * r->ph * 4);
+	if (!px || !vk_target_read(rt, 0, 0, r->pw, r->ph, 0, px)) {
+		free(px);
+		return;
+	}
+	/* vk_target_read gives rows bottom-up; cap_bmp wants them top-down */
+	uint8_t *td = malloc((size_t)r->pw * r->ph * 4);
+	uint32_t lit = 0;
+	for (uint32_t y = 0; td && y < r->ph; y++)
+		for (uint32_t x = 0; x < r->pw; x++) {
+			const uint8_t *q = px + ((size_t)(r->ph - 1 - y) * r->pw + x) * 4;
+			uint8_t *o = td + ((size_t)y * r->pw + x) * 4;
+			if (alpha) { o[0] = o[1] = o[2] = q[3]; o[3] = 255; } else memcpy(o, q, 4);
+			lit += q[3] != 0;
+		}
+	if (td)
+		cap_bmp(name, td, r->pw, r->ph, 1280);
+	LOG("replay: %s, %u pixels with alpha\n", name, lit);
+	free(td);
+	free(px);
+}
+
+
+/* A whole captured frame again (decision log D43): its events in order -- targets bound, clears, draws -- through this
+ * backend, with each draw's own state, inputs and textures, and the presented target written as rf<n>.bmp. */
+#define RF_MAP 512
+/* `mode`: "full"; "only=N" draws only draw N; "stop=N" stops after draw N; "sync" finishes each draw before the
+ * next; "fresh" forgets the dynamic state and the descriptor set before each draw; "noset" the descriptor set only. */
+static void replay_frame(int n, const char *mode)
+{
+	int only = -1, stop = -1, msync = !strcmp(mode, "sync"), fresh = !strcmp(mode, "fresh"),
+	    noset = !strcmp(mode, "noset");
+	sscanf(mode, "only=%d", &only);
+	sscanf(mode, "stop=%d", &stop);
+	int stopped = 0;
+	char name[512];
+	snprintf(name, sizeof name, CAP_DIR "/c%d_events.txt", n);
+	size_t len;
+	char *ev = (char *)replay_file(name, &len);
+	if (!ev) {
+		LOG("replay frame %d: no events\n", n);
+		return;
+	}
+	static uint32_t rt_from[RF_MAP], rt_to[RF_MAP], tex_from[RF_MAP], tex_to[RF_MAP], prog_from[RF_MAP], prog_to[RF_MAP];
+	uint32_t nrt = 0, ntex = 0, nprog = 0, cur = 0, draws = 0, failed = 0;
+	int keep_zrev = g_zrev;
+	char *save = NULL;
+	for (char *line = strtok_r(ev, "\n", &save); line; line = strtok_r(NULL, "\n", &save)) {
+		unsigned a, b, c, d;
+		int zr;
+		if (sscanf(line, "zrev %d", &zr) == 1) {
+			g_zrev = zr;
+		} else if (sscanf(line, "bind %u %u %u %u", &a, &b, &c, &d) == 4) {
+			uint32_t i;
+			for (i = 0; i < nrt && rt_from[i] != a; i++)
+				;
+			if (i == nrt && nrt < RF_MAP) {
+				rt_from[nrt] = a;
+				rt_to[nrt] = vk_target_new(b, c);
+				/* the captured target's colour texture is this one's from now on */
+				if (ntex < RF_MAP && rt_to[nrt]) {
+					tex_from[ntex] = d;
+					tex_to[ntex++] = g_rt[rt_to[nrt] - 1].color;
+				}
+				nrt++;
+			}
+			if (i < nrt && rt_to[i]) {
+				vk_target_bind(rt_to[i]);
+				cur = rt_to[i];
+			}
+		} else if (!strncmp(line, "clear ", 6)) {
+			unsigned mask, st, r[4];
+			float rgba[4], depth;
+			int k = sscanf(line + 6, "%u %f %f %f %f %f %u %u %u %u %u", &mask, &rgba[0], &rgba[1], &rgba[2], &rgba[3],
+			               &depth, &st, &r[0], &r[1], &r[2], &r[3]);
+			if (k >= 7 && cur)
+				vk_clear(mask, rgba, depth, st, k == 11 ? r : NULL);
+		} else if (sscanf(line, "draw %u %u %u", &a, &b, &c) == 3) {
+			if (stopped || (only >= 0 && (int)a != only))
+				continue;
+			if (stop >= 0 && (int)a > stop)
+				stopped = 1;
+			if (stopped)
+				continue;
+			snprintf(name, sizeof name, CAP_DIR "/c%d_d%u.bin", n, a);
+			size_t bl;
+			uint8_t *bin = replay_file(name, &bl);
+			if (!bin || bl < 100 || ((uint32_t *)bin)[0] != 0x32504143u) {
+				free(bin);
+				failed++;
+				continue;
+			}
+			uint32_t hd[24], rsz, bound[4];
+			memcpy(hd, bin, sizeof hd);
+			memcpy(&rsz, bin + 96, 4);
+			const uint8_t *q = bin + 100;
+			Nv2aRenderState rs;
+			memcpy(&rs, q, rsz < sizeof rs ? rsz : sizeof rs);
+			q += rsz;
+			memcpy(bound, q, sizeof bound);
+			q += sizeof bound;
+			uint32_t vus = hd[2], fus = hd[3], stride = hd[4], nv = hd[5];
+			const uint8_t *vu = q, *fu = vu + vus;
+			const float *gen = (const float *)(fu + fus), *verts = gen + 64;
+			if ((size_t)(q - bin) + vus + fus + 256 + (size_t)stride * nv * 4 > bl) {
+				free(bin);
+				failed++;
+				continue;
+			}
+			/* the program, made once from the capture's Vulkan GLSL */
+			uint32_t i;
+			for (i = 0; i < nprog && prog_from[i] != hd[1]; i++)
+				;
+			if (i == nprog && nprog < RF_MAP) {
+				size_t vl, fl;
+				snprintf(name, sizeof name, CAP_DIR "/c%d_p%u.vert", n, hd[1]);
+				char *vs = (char *)replay_file(name, &vl);
+				snprintf(name, sizeof name, CAP_DIR "/c%d_p%u.frag", n, hd[1]);
+				char *fs = (char *)replay_file(name, &fl);
+				uint32_t slot;
+				for (slot = 0; slot < MAX_PROG && g_prog[slot].used; slot++)
+					;
+				prog_from[nprog] = hd[1];
+				prog_to[nprog] = 0;
+				if (vs && fs && slot < MAX_PROG) {
+					VkProg *p = &g_prog[slot];
+					memset(p, 0, sizeof *p);
+					p->vs = compile_stage(vs, GLSLANG_STAGE_VERTEX, "replay");
+					p->fs = compile_stage(fs, GLSLANG_STAGE_FRAGMENT, "replay");
+					for (int at = 0; at < 16; at++) {
+						char pat[32];
+						snprintf(pat, sizeof pat, "in vec4 v%d;", at);
+						if (strstr(vs, pat)) p->inputs |= 1u << at;
+					}
+					for (int u = 0; u < 4; u++) {
+						char pat[48];
+						snprintf(pat, sizeof pat, "binding = %d) uniform sampler2D", 2 + u);
+						if (strstr(fs, pat)) p->samplers |= 1u << u;
+					}
+					for (int s2 = 0; s2 < 2; s2++)
+						for (int u = 0; u < NV2A_U_COUNT; u++) p->off[s2][u] = -1;
+					p->used = p->vs && p->fs;
+					if (p->used)
+						prog_to[nprog] = slot + 1;
+				}
+				free(vs);
+				free(fs);
+				nprog++;
+			}
+			uint32_t ph = i < nprog ? prog_to[i] : 0;
+			if (!ph) {
+				free(bin);
+				failed++;
+				continue;
+			}
+			VkProg *p = &g_prog[ph - 1];
+			free(p->vu);
+			free(p->fu);
+			p->vu = malloc(vus ? vus : 16);
+			p->fu = malloc(fus ? fus : 16);
+			memcpy(p->vu, vu, vus);
+			memcpy(p->fu, fu, fus);
+			p->vu_size = vus;
+			p->fu_size = fus;
+			p->dirty_v = p->dirty_f = 1;
+			/* its textures: a target's colour as the replay's target, anything else from the capture's raw file */
+			uint32_t tx[4] = {0};
+			for (int u = 0; u < 4; u++) {
+				if (!bound[u])
+					continue;
+				uint32_t k;
+				for (k = 0; k < ntex && tex_from[k] != bound[u]; k++)
+					;
+				if (k == ntex && ntex < RF_MAP) {
+					snprintf(name, sizeof name, CAP_DIR "/c%d_t%u.raw", n, bound[u]);
+					size_t tl;
+					uint8_t *raw = replay_file(name, &tl);
+					tex_from[ntex] = bound[u];
+					tex_to[ntex] = 0;
+					if (raw && tl >= 8 + sizeof(Nv2aSampler)) {
+						uint32_t w, h;
+						Nv2aSampler sm;
+						memcpy(&w, raw, 4);
+						memcpy(&h, raw + 4, 4);
+						memcpy(&sm, raw + 8, sizeof sm);
+						sm.levels = 0; /* the replay has level 0 only; the device makes the rest */
+						if (tl >= 8 + sizeof sm + (size_t)w * h * 4)
+							tex_to[ntex] = vk_tex_new(w, h, raw + 8 + sizeof sm, &sm);
+					}
+					free(raw);
+					ntex++;
+				}
+				tx[u] = k < ntex ? tex_to[k] : 0;
+			}
+			int at16[16];
+			uint32_t cmask = 0;
+			for (int at = 0; at < 16; at++) {
+				at16[at] = (int)hd[6 + at];
+				if (at16[at] < 0) cmask |= 1u << at;
+			}
+			g_rs = rs;
+			{
+				/* JSRF_RF_STRIP: parts of each draw's state left out, to find the one at fault: 1 stencil, 2 blend,
+				 * 4 depth, 8 culling, 16 the colour mask (all channels), 32 every unit but the first */
+				const char *v = getenv("JSRF_RF_STRIP");
+				unsigned strip = v ? (unsigned)strtoul(v, NULL, 0) : 0;
+				if (strip & 1) g_rs.stencil_test = 0;
+				if (strip & 2) g_rs.blend_enable = 0;
+				if (strip & 4) g_rs.depth_test = g_rs.depth_write = 0;
+				if (strip & 8) g_rs.cull_enable = 0;
+				if (strip & 16) g_rs.color_mask = 0x01010101u;
+				if (strip & 32) tx[1] = tx[2] = tx[3] = 0;
+				if (strip & 64) tx[0] = tx[1] = tx[2] = tx[3] = 0;
+			}
+			vk_vertices(verts, nv, stride, at16, cmask, (const float (*)[4])gen);
+			g_cur_prog = ph;
+			for (int u = 0; u < 4; u++) vk_texture(u, tx[u]);
+			{
+				/* JSRF_RF_SYNC: each draw finished before the next, to find one that faults; JSRF_RF_SKIP=a,b: leave
+				 * out the draws numbered a to b */
+				static int sync = -1;
+				static unsigned skip_a = 1, skip_b = 0;
+				if (sync < 0) {
+					const char *v = getenv("JSRF_RF_SYNC");
+					sync = v && *v == '1';
+					v = getenv("JSRF_RF_SKIP");
+					if (v)
+						sscanf(v, "%u,%u", &skip_a, &skip_b);
+				}
+				if (a >= skip_a && a <= skip_b) {
+					free(bin);
+					continue;
+				}
+				if (sync)
+					LOG("replay frame %d: draw %u (p%u prim %u n %u)\n", n, a, hd[1], hd[22], hd[23]);
+				if (fresh) {
+					pass_end();
+					E.valid = 0;
+				}
+				if (fresh || noset)
+					g_set = VK_NULL_HANDLE;
+				uint32_t cnt = nv < hd[23] ? nv : hd[23];
+				{
+					const char *v = getenv("JSRF_RF_NV"); /* at most this many vertices a draw */
+					if (v && (uint32_t)atoi(v) < cnt)
+						cnt = (uint32_t)atoi(v) / 3 * 3;
+				}
+				vk_draw((int)hd[22], cnt);
+				if (sync || msync)
+					submit(VK_NULL_HANDLE, VK_NULL_HANDLE, 1);
+			}
+			draws++;
+			free(bin);
+		} else if (sscanf(line, "present %u", &a) == 1) {
+			uint32_t i;
+			for (i = 0; i < nrt && rt_from[i] != a; i++)
+				;
+			/* every target as it stands: this title draws a frame into one and copies it to the shown one at the
+			 * start of the next, so the presented target still holds the frame before */
+			(void)i;
+			for (uint32_t k = 0; k < nrt; k++)
+				if (rt_to[k]) {
+					snprintf(name, sizeof name, CAP_DIR "/rf%d_%s_rt%u.bmp", n, mode, rt_from[k]);
+					replay_bmp(name, rt_to[k], 0);
+				}
+		}
+	}
+	if (stopped || only >= 0) {
+		/* the targets as they stand where the replay stopped */
+		for (uint32_t k = 0; k < nrt; k++)
+			if (rt_to[k]) {
+				snprintf(name, sizeof name, CAP_DIR "/rf%d_%s_rt%u.bmp", n, mode, rt_from[k]);
+				replay_bmp(name, rt_to[k], 0);
+			}
+	}
+	LOG("replay frame %d (%s): %u draws, %u failed, %u targets, %u textures, %u programs\n", n, mode, draws, failed,
+	    nrt, ntex, nprog);
+	g_zrev = keep_zrev;
+	g_cur_prog = 0;
+	free(ev);
+}
+
+void nv2a_vk_replay(const char *list)
+{
+	size_t len;
+	char *txt = (char *)replay_file(list, &len);
+	if (!txt || !vk_init()) {
+		LOG("replay: no list %s\n", list);
+		free(txt);
+		return;
+	}
+	char *save = NULL;
+	for (char *line = strtok_r(txt, "\n", &save); line; line = strtok_r(NULL, "\n", &save)) {
+		char bin[128], vsn[128], fsn[128], tn[4][128], out[128];
+		int fr;
+		char fmode[64] = "full";
+		if (sscanf(line, "frame %d %63s", &fr, fmode) >= 1) {
+			replay_frame(fr, fmode);
+			continue;
+		}
+		int st[8] = {0, 0x302, 0x303, 0, 0, 0x203, 0, 0x405};
+		int fe = 0x900;
+		if (sscanf(line, "%127s %127s %127s %127s %127s %127s %127s %127s %d %x %x %d %d %x %d %x %x", bin, vsn, fsn,
+		           tn[0], tn[1], tn[2], tn[3], out, &st[0], &st[1], &st[2], &st[3], &st[4], &st[5], &st[6], &st[7],
+		           &fe) < 8)
+			continue;
+		size_t bl, vl, fl;
+		uint8_t *b = replay_file(bin, &bl);
+		char *vs = (char *)replay_file(vsn, &vl), *fs = (char *)replay_file(fsn, &fl);
+		if (!b || !vs || !fs || bl < 96) {
+			LOG("replay: %s: missing input\n", out);
+			free(b); free(vs); free(fs);
+			continue;
+		}
+		uint32_t hd[24];
+		memcpy(hd, b, sizeof hd);
+		uint32_t vus = hd[2], fus = hd[3], stride = hd[4], nv = hd[5];
+		int at[16];
+		for (int i = 0; i < 16; i++) at[i] = (int)hd[6 + i];
+		const uint8_t *vu = b + 96, *fu = vu + vus;
+		const float *gen = (const float *)(fu + fus), *verts = gen + 64;
+		int i;
+		for (i = 0; i < MAX_PROG && g_prog[i].used; i++)
+			;
+		if (i == MAX_PROG || 96 + vus + fus + 256 + (size_t)stride * nv * 4 > bl) {
+			free(b); free(vs); free(fs);
+			continue;
+		}
+		VkProg *p = &g_prog[i];
+		memset(p, 0, sizeof *p);
+		p->vs = compile_stage(vs, GLSLANG_STAGE_VERTEX, "replay");
+		p->fs = compile_stage(fs, GLSLANG_STAGE_FRAGMENT, "replay");
+		for (int a = 0; a < 16; a++) {
+			char pat[32];
+			snprintf(pat, sizeof pat, "in vec4 v%d;", a);
+			if (strstr(vs, pat)) p->inputs |= 1u << a;
+		}
+		for (int u = 0; u < 4; u++) {
+			char pat[48];
+			snprintf(pat, sizeof pat, "binding = %d) uniform sampler2D", 2 + u);
+			if (strstr(fs, pat)) p->samplers |= 1u << u;
+		}
+		p->vu_size = vus; p->fu_size = fus;
+		p->vu = malloc(vus ? vus : 16); p->fu = malloc(fus ? fus : 16);
+		memcpy(p->vu, vu, vus); memcpy(p->fu, fu, fus);
+		for (int s2 = 0; s2 < 2; s2++)
+			for (int u = 0; u < NV2A_U_COUNT; u++) p->off[s2][u] = -1;
+		p->dirty_v = p->dirty_f = 1;
+		p->used = p->vs && p->fs;
+		uint32_t tex[4] = {0};
+		for (int u = 0; u < 4; u++)
+			if (strcmp(tn[u], "-")) tex[u] = replay_tex(tn[u]);
+		uint32_t cmask = 0;
+		int aat[16];
+		for (int a = 0; a < 16; a++) {
+			aat[a] = at[a];
+			if (at[a] < 0) cmask |= 1u << a;
+		}
+		/* A nothing, B all of the state, C culling only, D culling with the front face turned, E depth only,
+		 * F blending only */
+		for (int var = 0; var < 6 && p->used; var++) {
+			uint32_t rt = vk_target_new(1280, 960);
+			vk_target_bind(rt);
+			float bg[4] = {0.2f, 0.2f, 0.2f, 0.0f};
+			/* the far plane for the function given (the front half turns them round with reversed depth, which
+			 * is not yet on when the replay runs) */
+			vk_clear(7, bg, (st[5] == 0x204 || st[5] == 0x206) ? 0.0f : 1.0f, 0, NULL);
+			memset(&g_rs, 0, sizeof g_rs);
+			g_rs.color_mask = 0x01010101u;
+			g_rs.front_face = fe;
+			if (var == 1 || var == 5) {
+				g_rs.blend_enable = st[0]; g_rs.blend_src = st[1]; g_rs.blend_dst = st[2];
+			}
+			if (var == 1 || var == 4) {
+				g_rs.depth_test = st[3]; g_rs.depth_write = st[4]; g_rs.depth_func = st[5];
+			}
+			if (var == 1 || var == 2 || var == 3) {
+				g_rs.cull_enable = st[6]; g_rs.cull_face = st[7];
+				if (var == 3)
+					g_rs.front_face = fe == 0x901 ? 0x900 : 0x901;
+			}
+			E.valid = 0;
+			vk_vertices(verts, nv, stride, aat, cmask, (const float (*)[4])gen);
+			g_cur_prog = (uint32_t)i + 1;
+			for (int u = 0; u < 4; u++) vk_texture(u, tex[u]);
+			vk_draw(NV2A_PRIM_TRIANGLES, nv / 3 * 3);
+			char name[512];
+			snprintf(name, sizeof name, CAP_DIR "/%s_%c.bmp", out, 'A' + var);
+			replay_bmp(name, rt, 0);
+			/* the targets, textures and program stay: freeing them here crashed in the next frame_start, and the
+			 * replay runs once */
+		}
+		if (!p->used) LOG("replay: %s: shaders did not compile\n", out);
+		if (g_cur_prog == (uint32_t)i + 1)
+			g_cur_prog = 0;
+		free(b); free(vs); free(fs);
+	}
+	free(txt);
+	submit(VK_NULL_HANDLE, VK_NULL_HANDLE, 1);
+	g_cur_rt = 0;
+	memset(&g_rs, 0, sizeof g_rs);
+	E.valid = 0;
+	LOG("replay done\n");
+}
+
+static const Nv2aGfx g_vk = {
+	.name = "Vulkan",
+	.lang = NV2A_LANG_GLSL,
+	.rt_bottom_up = 0,
+	.init = vk_init,
+	.target_new = vk_target_new,
+	.target_free = vk_target_free,
+	.target_bind = vk_target_bind,
+	.target_texture = vk_target_texture,
+	.target_snapshot = vk_target_snapshot,
+	.target_read = vk_target_read,
+	.target_read_depth = vk_target_read_depth,
+	.tex_new = vk_tex_new,
+	.tex_free = vk_tex_free,
+	.tex_read = vk_tex_read,
+	.prog_new = vk_prog_new,
+	.prog_free = vk_prog_free,
+	.prog_uses = vk_prog_uses,
+	.prog_use = vk_prog_use,
+	.uniform_f = vk_uniform_f,
+	.uniform_i = vk_uniform_i,
+	.texture = vk_texture,
+	.state = vk_state,
+	.state_invalidate = vk_state_invalidate,
+	.vertices = vk_vertices,
+	.draw = vk_draw,
+	.clear = vk_clear,
+	.present = vk_present,
+	.report = vk_report,
+	.uniform_f_part = vk_uniform_f_part,
+	.pipeline_ms = vk_pipeline_ms,
+#if !defined(NV2A_VK_HOST)
+	.cache_open = vk_cache_open,
+	.cache_idle = vk_cache_idle,
+#endif
+	.zrev = vk_zrev,
+	.vbuf_new = vk_vbuf_new,
+	.vbuf_free = vk_vbuf_free,
+	.vbuf_fill = vk_vbuf_fill,
+	.vbuf_bind = vk_vbuf_bind,
+	.draw_indexed = vk_draw_indexed,
+};
+
+const Nv2aGfx *nv2a_gfx_vk(void) { return &g_vk; }
diff --git a/src/platform/recomp_regfile.h b/src/platform/recomp_regfile.h
new file mode 100644
index 0000000..e5cf3b7
--- /dev/null
+++ b/src/platform/recomp_regfile.h
@@ -0,0 +1,117 @@
+/*
+ * recomp_regfile.h - the guest's registers in one thread-local block, on the
+ * PlayStation 5 (jsrf-ps5 decision log D46, after PS5_Burnout3's).
+ *
+ * The registers are thread-local (RECOMP_TLS): each guest thread has its own
+ * set. A PS5 title is built with emulated TLS, where every access to a
+ * thread-local is a call (__emutls_get_address; 237,936 of them in this
+ * title's code), and lifted code touches eax, esp and the rest in nearly
+ * every statement. Native TLS is not open to a title there.
+ *
+ * So the registers live in one thread-local struct, reached through
+ * recomp_regfile(), declared const: its result depends on nothing the
+ * compiler can see change, so a function asks once and keeps the pointer.
+ * The g_* names become that struct's fields, for the generated code and the
+ * runtime alike.
+ *
+ * Force-included into every source of the PS5 builds (CMakeLists.txt), before
+ * recomp_types.h and xbox_memory_layout.h, whose own declarations of these
+ * names step aside (RECOMP_REGFILE). Elsewhere this header is empty.
+ */
+#ifndef RECOMP_REGFILE_H
+#define RECOMP_REGFILE_H
+
+#if defined(JSRF_PS5)
+#include <stdint.h>
+
+#define RECOMP_REGFILE 1
+
+/* The SSE and MMX registers' types, as recomp_types.h and
+ * xbox_memory_layout.h define them (which skip theirs when these exist). */
+#ifndef RECOMP_XMM_DEFINED
+#define RECOMP_XMM_DEFINED
+typedef union RecompXmm {
+    float    f[4];
+    double   d[2];
+    uint32_t u[4];
+    int32_t  i[4];
+    uint64_t q[2];
+} RecompXmm;
+#endif
+#ifndef RECOMP_MMX_DEFINED
+#define RECOMP_MMX_DEFINED
+typedef union RecompMmx {
+    int8_t   b[8];
+    uint8_t  ub[8];
+    int16_t  w[4];
+    uint16_t uw[4];
+    int32_t  d[2];
+    uint32_t ud[2];
+    uint64_t q;
+} RecompMmx;
+#endif
+
+/* (r_ names: the generated code defines eax, esp ... as macros) */
+typedef struct RecompRegFile {
+    uint32_t r_eax, r_ecx, r_edx, r_esp, r_ebx, r_esi, r_edi, r_ebp;
+    uint32_t r_fs_base, r_seh_ebp, r_eflags, r_mxcsr;
+    int r_df, r_fp_top, r_fp_cmp;
+    uint16_t r_fp_control_word, r_fp_cc;
+    double r_fp_stack[8];
+    RecompXmm r_xmm[8];
+    RecompMmx r_mm[8];
+    /* The runtime's own per-thread state that the lifted code reaches on
+     * every loop back edge (xbox_GuestCpuPreempt) and kernel call: the guest
+     * lock's bookkeeping, IRQL, the kernel dispatch, the last error (D50).
+     * Each file names its own fields; pointers are kept as void *. */
+    uint32_t r_kernel_caller, r_thread_stack_top, r_last_error, r_tid;
+    int r_guest_holds, r_guest_idle, r_lock_slot, r_dispatch_slot, r_in_callback;
+    int r_is_spawned, r_apc_head, r_apc_count, r_jmp_used;
+    long long r_guest_since;
+    void *r_self_obj, *r_kthread;
+    uint8_t r_irql;
+} RecompRegFile;
+
+#ifdef __cplusplus
+extern "C"
+#endif
+RecompRegFile *recomp_regfile(void) __attribute__((const, nothrow));
+
+#define g_eax             (recomp_regfile()->r_eax)
+#define g_ecx             (recomp_regfile()->r_ecx)
+#define g_edx             (recomp_regfile()->r_edx)
+#define g_esp             (recomp_regfile()->r_esp)
+#define g_ebx             (recomp_regfile()->r_ebx)
+#define g_esi             (recomp_regfile()->r_esi)
+#define g_edi             (recomp_regfile()->r_edi)
+#define g_ebp             (recomp_regfile()->r_ebp)
+#define g_fs_base         (recomp_regfile()->r_fs_base)
+#define g_seh_ebp         (recomp_regfile()->r_seh_ebp)
+#define g_eflags          (recomp_regfile()->r_eflags)
+#define g_mxcsr           (recomp_regfile()->r_mxcsr)
+#define g_df              (recomp_regfile()->r_df)
+#define g_fp_top          (recomp_regfile()->r_fp_top)
+#define g_fp_cmp          (recomp_regfile()->r_fp_cmp)
+#define g_fp_control_word (recomp_regfile()->r_fp_control_word)
+#define g_fp_cc           (recomp_regfile()->r_fp_cc)
+#define g_fp_stack        (recomp_regfile()->r_fp_stack)
+#define g_xmm0            (recomp_regfile()->r_xmm[0])
+#define g_xmm1            (recomp_regfile()->r_xmm[1])
+#define g_xmm2            (recomp_regfile()->r_xmm[2])
+#define g_xmm3            (recomp_regfile()->r_xmm[3])
+#define g_xmm4            (recomp_regfile()->r_xmm[4])
+#define g_xmm5            (recomp_regfile()->r_xmm[5])
+#define g_xmm6            (recomp_regfile()->r_xmm[6])
+#define g_xmm7            (recomp_regfile()->r_xmm[7])
+#define g_mm0             (recomp_regfile()->r_mm[0])
+#define g_mm1             (recomp_regfile()->r_mm[1])
+#define g_mm2             (recomp_regfile()->r_mm[2])
+#define g_mm3             (recomp_regfile()->r_mm[3])
+#define g_mm4             (recomp_regfile()->r_mm[4])
+#define g_mm5             (recomp_regfile()->r_mm[5])
+#define g_mm6             (recomp_regfile()->r_mm[6])
+#define g_mm7             (recomp_regfile()->r_mm[7])
+#define g_xbox_kernel_caller (recomp_regfile()->r_kernel_caller)
+#endif /* JSRF_PS5 */
+
+#endif /* RECOMP_REGFILE_H */
